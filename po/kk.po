#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:1
msgid "Enable address formatting"
msgstr "Адресті пішімдеуді іске қосу"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:2
msgid "Whether addresses should be formatted according to standard in their destination country"
msgstr "Адрестерді тағайындалған елдің стандартына сай пішімдеу керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:3
msgid "Autocomplete length"
msgstr "Автотолықтыру ұзындығы"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:4
msgid "The number of characters that must be typed before Evolution will attempt to autocomplete."
msgstr "Evolution автотолтыруды бастау үшін терілуі тиіс таңбалар саны."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:5
msgid "Show autocompleted name with an address"
msgstr "Автотолтырылған аты-жөнін адреспен бірге көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:6
msgid "Whether force showing the mail address with the name of the autocompleted contact in the entry."
msgstr "Өрісте автотолтырылған контактінің аты-жөнімен бірге пошта адресін міндетті түрде көрсету керек пе."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:7
msgid "URI for the folder last used in the select names dialog"
msgstr "Атты таңдау сұхбат терезесінде соңғы рет пайдаланылған буманың URI"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:8
msgid "URI for the folder last used in the select names dialog."
msgstr "Атты таңдау сұхбат терезесінде соңғы рет пайдаланылған буманың URI."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:9
msgid "Contact layout style"
msgstr "Контактілер жаймасының стилі"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:10
msgid "The layout style determines where to place the preview pane in relation to the contact list. “0” (Classic View) places the preview pane below the contact list. “1” (Vertical View) places the preview pane next to the contact list."
msgstr ""
"Жайма стилі алдын ала қарау панелінің контактілер тізіміне қатысты орналасуын анықтайды. «0» (Классикалық көрініс) алдын ала қарау панелін контактілер тізімінің астына орналастырады. «1» (Вертикалды көрініс) алдын ала қарау панелін контактілер тізімінің жанына "
"орналастырады."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:11
msgid "Contact preview pane position (horizontal)"
msgstr "Контактілердің алдын ала қарау панелінің орны (горизонталды)"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:12
msgid "Position of the contact preview pane when oriented horizontally."
msgstr "Горизонталды бағытталған кездегі контактілердің алдын ала қарау панелінің орны."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:13
msgid "Contact preview pane position (vertical)"
msgstr "Контактілердің алдын ала қарау панелінің орны (вертикалды)"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:14
msgid "Position of the contact preview pane when oriented vertically."
msgstr "Вертикалды бағытталған кездегі контактілердің алдын ала қарау панелінің орны."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:15
msgid "Show maps"
msgstr "Карталарды көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:16
msgid "Whether to show maps in preview pane"
msgstr "Алдын-ала қарау панелінде карталарды көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:17
msgid "Primary address book"
msgstr "Негізгі адрестік кітапша"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:18
msgid "The UID of the selected (or “primary”) address book in the sidebar of the “Contacts” view"
msgstr "«Контактілер» көрінісінің бүйірлік панеліндегі таңдалған (немесе «негізгі») адрес кітабының UID идентификаторы"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:19
msgid "Show preview pane"
msgstr "Алдын-ала қарау панелін көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:20
msgid "Whether to show the preview pane."
msgstr "Алдын ала қарау панелін көрсету керек пе."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:21
msgid "Show phone numbers"
msgstr "Телефон нөмірлерін көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:22
msgid "Whether to show phone numbers in the editor"
msgstr "Түзеткіште телефон нөмірлерін көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:23
msgid "Show SIP addresses"
msgstr "SIP адрестерін көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:24
msgid "Whether to show SIP addresses in the editor"
msgstr "Түзеткіште SIP адрестерін көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:25
msgid "Show IM addresses"
msgstr "IM адрестерін көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:26
msgid "Whether to show IM addresses in the editor"
msgstr "Түзеткіште IM адрестерін көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:27
msgid "Show mailing Home addresses"
msgstr "Үй пошта адрестерін көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:28
msgid "Whether to show mailing Home addresses in the editor"
msgstr "Түзеткіште үй пошта адрестерін көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:29
msgid "Show mailing Work addresses"
msgstr "Жұмыс пошта адрестерін көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:30
msgid "Whether to show mailing addresses Work in the editor"
msgstr "Түзеткіште жұмыс пошта адрестерін көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:31
msgid "Show mailing Other addresses"
msgstr "Басқа пошта адрестерін көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:32
msgid "Whether to show mailing addresses Other in the editor"
msgstr "Түзеткіште басқа пошта адрестерін көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:33
msgid "Show web addresses"
msgstr "Веб-адрестерді көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:34
msgid "Whether to show Web Addresses in the editor"
msgstr "Түзеткіште веб-адрестерді көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:35
msgid "Show job information"
msgstr "Жұмыс туралы ақпаратты көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:36
msgid "Whether to show job information in the editor"
msgstr "Түзеткіште жұмыс туралы ақпаратты көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:37
msgid "Show dates"
msgstr "Күндерді көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:38
msgid "Whether to show Dates section in the editor"
msgstr "Түзеткіште Күндер бөлімін көрсету-көрсетпеуді анықтайды"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:39
msgid "Show Miscellaneous information"
msgstr "Әртүрлі ақпаратты көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:40
msgid "Whether to show Miscellaneous information in the editor"
msgstr "Түзеткіште әртүрлі ақпаратты көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:41
msgid "Show notes-tab"
msgstr "Жазбалар бетін көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:42
msgid "Whether to show notes in the editor"
msgstr "Түзеткіште жазбаларды көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:43
msgid "Show Certificates tab"
msgstr "Сертификаттар бетін көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:44
msgid "Whether to show Certificates tab in the editor"
msgstr "Түзеткіште сертификаттар бетін көрсету керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:45
msgid "Where to open contact locations"
msgstr "Контактілердің орналасқан жерін қайда ашу керек"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:46
msgid "Currently supported values are “openstreetmap” and “google”; if unknown set, uses “openstreetmap”"
msgstr "Қазіргі уақытта қолдау көрсетілетін мәндер — «openstreetmap» және «google»; егер белгісіз мән орнатылса, «openstreetmap» пайдаланылады"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:47
msgid "Whether to prefer local application over opening map in a browser"
msgstr "Картаны браузерде ашудың орнына жергілікті қолданбаға басымдық беру керек пе"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:48
msgid "Open a contact location in a local application handling 'map:' URI, if available, instead of using a web browser"
msgstr "Контактінің орналасқан жерін веб-браузердің орнына «map:» URI өңдейтін жергілікті қолданбада ашу (қолжетімді болса)"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:49
msgid "Preview Personal before Work information"
msgstr "Жұмыс ақпаратының алдында жеке ақпаратты қарау"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:50
msgid "Show the Personal information before the Work information in the contact preview"
msgstr "Контактіні алдын ала қарау кезінде жұмыс ақпаратының алдында жеке ақпаратты көрсету"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:51
msgid "Whether to use an old contact editor"
msgstr "Ескі контакт түзеткішін пайдалану-пайдаланбауды анықтайды"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:52
msgid "The option can let choose whether an old or a new contact editor will be used in the application"
msgstr "Бұл опция қолданбада ескі немесе жаңа контакт түзеткіші пайдаланылатынын таңдауға мүмкіндік береді"

#: ../data/org.gnome.evolution.bogofilter.gschema.xml.in.h:1
msgid "Convert mail messages to Unicode"
msgstr "Пошта хабарламаларын Юникодқа түрлендіру"

#: ../data/org.gnome.evolution.bogofilter.gschema.xml.in.h:2
msgid "Convert message text to Unicode UTF-8 to unify spam/ham tokens coming from different character sets."
msgstr "Әртүрлі таңбалар жиынынан келетін спам/хэм белгілерін біріздендіру үшін хабарлама мәтінін Юникод UTF-8-ге түрлендіру."

#: ../data/org.gnome.evolution.bogofilter.gschema.xml.in.h:3
msgid "Full path command to run Bogofilter"
msgstr "Bogofilter іске қосуға арналған команданың толық жолы"

#: ../data/org.gnome.evolution.bogofilter.gschema.xml.in.h:4
msgid "Full path to a Bogofilter command. If not set, then a compile-time path is used, usually /usr/bin/bogofilter. The command should not contain any other arguments."
msgstr "Bogofilter командасының толық жолы. Егер орнатылмаса, құрастыру кезіндегі жол пайдаланылады (әдетте /usr/bin/bogofilter). Командада басқа аргументтер болмауы тиіс."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:1
msgid "Save directory for reminder audio"
msgstr "Еске салу аудиосы үшін сақтау бумасы"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:2
msgid "Directory for saving reminder audio files"
msgstr "Еске салу аудио файлдарын сақтауға арналған бума"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:3
msgid "Birthday and anniversary reminder value"
msgstr "Туған күн және мерейтой туралы еске салу мәні"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:4
msgid "Number of units for determining a birthday or anniversary reminder"
msgstr "Туған күн немесе мерейтой туралы еске салуды анықтауға арналған юниттер саны"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:5
msgid "Birthday and anniversary reminder units"
msgstr "Туған күн және мерейтой туралы еске салу юниттері"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:6
msgid "Units for a birthday or anniversary reminder, “minutes”, “hours” or “days”"
msgstr "Туған күн немесе мерейтой туралы еске салу юниттері: «minutes» (минут), «hours» (сағат) немесе «days» (күн)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:7
msgid "Compress weekends in month view"
msgstr "Айлық көріністе демалыс күндерін сығу"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:8
msgid "Whether to compress weekends in the month view, which puts Saturday and Sunday in the space of one weekday"
msgstr "Айлық көріністе демалыс күндерін сығу керек пе (бұл сенбі мен жексенбіні бір жұмыс күнінің орнына орналастырады)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:9
msgid "Ask for confirmation when deleting items"
msgstr "Элементтерді өшіру кезінде растауды сұрау"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:10
msgid "Whether to ask for confirmation when deleting an appointment or task"
msgstr "Кездесуді немесе тапсырманы өшіру кезінде растауды сұрау керек пе"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:11
msgid "Confirm expunge"
msgstr "Тазартуды растау"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:12
msgid "Whether to ask for confirmation when expunging appointments and tasks"
msgstr "Кездесулер мен тапсырмаларды тазарту кезінде растауды сұрау керек пе"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:13
msgid "Month view vertical pane position"
msgstr "Айлық көріністің вертикалды панелінің орны"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:14
msgid "Position of the vertical pane, between the calendar lists and the date navigator calendar"
msgstr "Вертикалды панельдің орны (күнтізбелер тізімі мен дата навигаторы күнтізбесі арасында)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:15
msgid "Workday end hour"
msgstr "Жұмыс күнінің аяқталу сағаты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:16
msgid "Hour the workday ends on, in twenty four hour format, 0 to 23"
msgstr "Жұмыс күнінің аяқталу сағаты, жиырма төрт сағаттық пішімде, 0-ден 23-ке дейін"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:17
msgid "Workday end minute"
msgstr "Жұмыс күнінің аяқталу минуты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:18
msgid "Minute the workday ends on, 0 to 59."
msgstr "Жұмыс күнінің аяқталу минуты, 0-ден 59-ға дейін."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:19
msgid "Workday start hour"
msgstr "Жұмыс күнінің басталу сағаты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:20
msgid "Hour the workday starts on, in twenty four hour format, 0 to 23."
msgstr "Жұмыс күнінің басталу сағаты, жиырма төрт сағаттық пішімде, 0-ден 23-ке дейін."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:21
msgid "Workday start minute"
msgstr "Жұмыс күнінің басталу минуты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:22
msgid "Minute the workday starts on, 0 to 59."
msgstr "Жұмыс күнінің басталу минуты, 0-ден 59-ға дейін."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:23
msgid "Workday start time for Monday"
msgstr "Дүйсенбі күні жұмыс күнінің басталу уақыты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:24
msgid "Time the workday starts on, in twenty four hour format HHMM, 0000 to 2359, or -1 to use day-start-hour and day-start-minute"
msgstr "Жұмыс күнінің басталу уақыты, жиырма төрт сағаттық HHMM пішімінде, 0000-нан 2359-ға дейін, немесе day-start-hour мен day-start-minute мәндерін пайдалану үшін -1"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:25
msgid "Workday end time for Monday"
msgstr "Дүйсенбі күні жұмыс күнінің аяқталу уақыты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:26
msgid "Time the workday ends on, in twenty four hour format HHMM, 0000 to 2359, or -1 to use day-end-hour and day-end-minute"
msgstr "Жұмыс күнінің аяқталу уақыты, жиырма төрт сағаттық HHMM пішімінде, 0000-нан 2359-ға дейін, немесе day-end-hour мен day-end-minute мәндерін пайдалану үшін -1"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:27
msgid "Workday start time for Tuesday"
msgstr "Сейсенбі күні жұмыс күнінің басталу уақыты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:28
msgid "Time the workday ends on, in twenty four hour format HHMM, 0000 to 2359, or -1 to use day-start-hour and day-start-minute"
msgstr "Жұмыс күнінің аяқталу уақыты, жиырма төрт сағаттық HHMM пішімінде, 0000-нан 2359-ға дейін, немесе day-start-hour мен day-start-minute мәндерін пайдалану үшін -1"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:29
msgid "Workday end time for Tuesday"
msgstr "Сейсенбі күні жұмыс күнінің аяқталу уақыты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:30
msgid "Workday start time for Wednesday"
msgstr "Сәрсенбі күні жұмыс күнінің басталу уақыты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:31
msgid "Workday end time for Wednesday"
msgstr "Сәрсенбі үшін жұмыс күнінің аяқталу уақыты"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:32
msgid "Workday start time for Thursday"
msgstr "Бейсенбі күні жұмыс күнінің басталу уақыты"

