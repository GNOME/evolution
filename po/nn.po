#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:1
msgid "Enable address formatting"
msgstr "Slå på adresseformatering"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:2
msgid ""
"Whether addresses should be formatted according to standard in their "
"destination country"
msgstr "Om adresser skal formaterast etter standarden i mottakarlandet"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:3
msgid "Autocomplete length"
msgstr "Autofullføringslengd"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:4
msgid ""
"The number of characters that must be typed before Evolution will attempt to "
"autocomplete."
msgstr ""
"Talet på teikn som må vere skrivne for at Evolution skal prøve å "
"autofullføre."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:5
msgid "Show autocompleted name with an address"
msgstr "Vis det autofullførte namnet med ei adresse"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:6
msgid ""
"Whether force showing the mail address with the name of the autocompleted "
"contact in the entry."
msgstr ""
"Om det skal tvingast gjennom at e-postadressa skal visast i lag med namnet "
"til den autofullførte kontakten i oppføringa."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:7
msgid "URI for the folder last used in the select names dialog"
msgstr "Adresse til mappa som vart sist brukt i «Vel namn»-dialogen"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:8
msgid "URI for the folder last used in the select names dialog."
msgstr "Adresse til mappa som vart sist brukt i «Vel namn»-dialogen."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:9
msgid "Contact layout style"
msgstr "Oppsettstil for kontaktar"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:10
msgid ""
"The layout style determines where to place the preview pane in relation to "
"the contact list. “0” (Classic View) places the preview pane below the "
"contact list. “1” (Vertical View) places the preview pane next to the "
"contact list."
msgstr ""
"Oppsettstilen avgjer kvar førehandsvisingsfeltet skal plasserast i forhold "
"til kontaktlista. «0» (Klassisk vising) plasserer førehandsvisingsfeltet "
"under kontaktlista. «1» (Loddrett vising) plasserer førehandsvisingsfeltet "
"ved sida av kontaktlista."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:11
msgid "Contact preview pane position (horizontal)"
msgstr "Plassering av førehandsvisingsfeltet for kontaktar (vassrett)"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:12
msgid "Position of the contact preview pane when oriented horizontally."
msgstr ""
"Plasseringa til førehandsvisingsfeltet for kontaktar når det er vassrett."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:13
msgid "Contact preview pane position (vertical)"
msgstr "Plassering av førehandsvisingsfeltet for kontaktar (loddrett)"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:14
msgid "Position of the contact preview pane when oriented vertically."
msgstr ""
"Plasseringa til førehandsvisingsfeltet for kontaktar når det er loddrett."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:15
msgid "Show maps"
msgstr "Vis kart"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:16
msgid "Whether to show maps in preview pane"
msgstr "Om kart skal visast i førehandsvisingsfeltet"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:17
msgid "Primary address book"
msgstr "Primær adressebok"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:18
msgid ""
"The UID of the selected (or “primary”) address book in the sidebar of the "
"“Contacts” view"
msgstr ""
"UID-en til den valde (eller «primære») adresseboka i sidepanelet i "
"«Kontaktar»-visinga"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:19
msgid "Show preview pane"
msgstr "Vis førehandsvisingsfeltet"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:20
msgid "Whether to show the preview pane."
msgstr "Om førehandsvisingsfeltet skal visast."

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:21
msgid "Show phone numbers"
msgstr "Vis telefonnummer"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:22
msgid "Whether to show phone numbers in the editor"
msgstr "Om telefonnummer skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:23
msgid "Show SIP addresses"
msgstr "Vis SIP-adresser"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:24
msgid "Whether to show SIP addresses in the editor"
msgstr "Om SIP-adresser skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:25
msgid "Show IM addresses"
msgstr "Vis lynmeldingsadresser"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:26
msgid "Whether to show IM addresses in the editor"
msgstr "Om lynmeldingsadresser skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:27
msgid "Show mailing Home addresses"
msgstr "Vis heimeadresser"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:28
msgid "Whether to show mailing Home addresses in the editor"
msgstr "Om heimeadresser skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:29
msgid "Show mailing Work addresses"
msgstr "Vis arbeidsadresser"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:30
msgid "Whether to show mailing addresses Work in the editor"
msgstr "Om arbeidsadresser skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:31
msgid "Show mailing Other addresses"
msgstr "Vis andre postadresser"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:32
msgid "Whether to show mailing addresses Other in the editor"
msgstr "Om andre postadresser skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:33
msgid "Show web addresses"
msgstr "Vis nettadresser"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:34
msgid "Whether to show Web Addresses in the editor"
msgstr "Om nettadresser skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:35
msgid "Show job information"
msgstr "Vis jobbinformasjon"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:36
msgid "Whether to show job information in the editor"
msgstr "Om jobbinformasjon skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:37
msgid "Show dates"
msgstr "Vis datoar"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:38
msgid "Whether to show Dates section in the editor"
msgstr "Om datodelen skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:39
msgid "Show Miscellaneous information"
msgstr "Vis diverse informasjon"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:40
msgid "Whether to show Miscellaneous information in the editor"
msgstr "Om diverse informasjon skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:41
msgid "Show notes-tab"
msgstr "Vis notatfana"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:42
msgid "Whether to show notes in the editor"
msgstr "Om notat skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:43
msgid "Show Certificates tab"
msgstr "Vis sertifikatfana"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:44
msgid "Whether to show Certificates tab in the editor"
msgstr "Om sertifikatfana skal visast i redigeringa"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:45
msgid "Where to open contact locations"
msgstr "Kvar kontaktstader skal opnast"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:46
msgid ""
"Currently supported values are “openstreetmap” and “google”; if unknown set, "
"uses “openstreetmap”"
msgstr ""
"Verdiane som er støtta no, er «openstreetmap» og «google»; om verdien er "
"ukjend, vert «openstreetmap» brukt"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:47
msgid "Whether to prefer local application over opening map in a browser"
msgstr ""
"Om eit lokalt program skal føretrekkjast framfor å opne kartet i ein "
"nettlesar"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:48
msgid ""
"Open a contact location in a local application handling 'map:' URI, if "
"available, instead of using a web browser"
msgstr ""
"Opne ein kontaktstad i eit lokalt program som handterer 'map:'-URI-ar, om "
"det finst, i staden for i ein nettlesar"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:49
msgid "Preview Personal before Work information"
msgstr "Vis personleg informasjon før arbeidsinformasjon"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:50
msgid ""
"Show the Personal information before the Work information in the contact "
"preview"
msgstr ""
"Vis personleg informasjon før arbeidsinformasjon i kontaktførehandsvisinga"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:51
msgid "Whether to use an old contact editor"
msgstr "Om den gamle kontaktredigeringa skal brukast"

#: ../data/org.gnome.evolution.addressbook.gschema.xml.in.h:52
msgid ""
"The option can let choose whether an old or a new contact editor will be "
"used in the application"
msgstr ""
"Valet avgjer om den gamle eller den nye kontaktredigeringa skal brukast i "
"programmet"

#: ../data/org.gnome.evolution.bogofilter.gschema.xml.in.h:1
msgid "Convert mail messages to Unicode"
msgstr "Konverter e-postmeldingar til Unicode"

#: ../data/org.gnome.evolution.bogofilter.gschema.xml.in.h:2
msgid ""
"Convert message text to Unicode UTF-8 to unify spam/ham tokens coming from "
"different character sets."
msgstr ""
"Konverter meldingsteksten til Unicode UTF-8 for å samordne spam/ham-token "
"som kjem frå ulike teiknsett."

#: ../data/org.gnome.evolution.bogofilter.gschema.xml.in.h:3
msgid "Full path command to run Bogofilter"
msgstr "Full sti til kommandoen for å køyre Bogofilter"

#: ../data/org.gnome.evolution.bogofilter.gschema.xml.in.h:4
msgid ""
"Full path to a Bogofilter command. If not set, then a compile-time path is "
"used, usually /usr/bin/bogofilter. The command should not contain any other "
"arguments."
msgstr ""
"Full sti til ein Bogofilter-kommando. Om han ikkje er sett, vert ein sti frå "
"kompileringa brukt, vanlegvis /usr/bin/bogofilter. Kommandoen skal ikkje "
"innehalde andre argument."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:1
msgid "Save directory for reminder audio"
msgstr "Lagringsmappe for påminningslydar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:2
msgid "Directory for saving reminder audio files"
msgstr "Mappe for lagring av påminningslydar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:3
msgid "Birthday and anniversary reminder value"
msgstr "Verdi for påminning om fødselsdagar og merkedagar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:4
msgid "Number of units for determining a birthday or anniversary reminder"
msgstr "Tal på einingar for påminning om fødselsdag eller merkedag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:5
msgid "Birthday and anniversary reminder units"
msgstr "Einingar for påminning om fødselsdagar og merkedagar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:6
msgid ""
"Units for a birthday or anniversary reminder, “minutes”, “hours” or “days”"
msgstr ""
"Einingar for påminning om fødselsdag eller merkedag, «minutes», «hours» "
"eller «days»"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:7
msgid "Compress weekends in month view"
msgstr "Komprimer helgar i månadsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:8
msgid ""
"Whether to compress weekends in the month view, which puts Saturday and "
"Sunday in the space of one weekday"
msgstr ""
"Om helgar skal komprimerast i månadsvisinga, slik at laurdag og sundag får "
"plassen til éin kvardag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:9
msgid "Ask for confirmation when deleting items"
msgstr "Be om stadfesting når oppføringar vert sletta"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:10
msgid "Whether to ask for confirmation when deleting an appointment or task"
msgstr ""
"Om det skal bedast om stadfesting når ein avtale eller ei oppgåve vert sletta"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:11
msgid "Confirm expunge"
msgstr "Stadfest tøming"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:12
msgid "Whether to ask for confirmation when expunging appointments and tasks"
msgstr "Om det skal bedast om stadfesting når avtalar og oppgåver vert tømde"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:13
msgid "Month view vertical pane position"
msgstr "Plasseringa av det loddrette feltet i månadsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:14
msgid ""
"Position of the vertical pane, between the calendar lists and the date "
"navigator calendar"
msgstr ""
"Plasseringa til det loddrette feltet mellom kalenderlistene og "
"datonavigatoren"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:15
msgid "Workday end hour"
msgstr "Timen arbeidsdagen sluttar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:16
msgid "Hour the workday ends on, in twenty four hour format, 0 to 23"
msgstr "Timen arbeidsdagen sluttar, i 24-timarsformat, 0 til 23"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:17
msgid "Workday end minute"
msgstr "Minuttet arbeidsdagen sluttar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:18
msgid "Minute the workday ends on, 0 to 59."
msgstr "Minuttet arbeidsdagen sluttar, 0 til 59."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:19
msgid "Workday start hour"
msgstr "Timen arbeidsdagen byrjar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:20
msgid "Hour the workday starts on, in twenty four hour format, 0 to 23."
msgstr "Timen arbeidsdagen byrjar, i 24-timarsformat, 0 til 23."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:21
msgid "Workday start minute"
msgstr "Minuttet arbeidsdagen byrjar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:22
msgid "Minute the workday starts on, 0 to 59."
msgstr "Minuttet arbeidsdagen byrjar, 0 til 59."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:23
msgid "Workday start time for Monday"
msgstr "Starttid for arbeidsdagen måndag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:24
msgid ""
"Time the workday starts on, in twenty four hour format HHMM, 0000 to 2359, "
"or -1 to use day-start-hour and day-start-minute"
msgstr ""
"Tidspunktet arbeidsdagen byrjar, i 24-timarsformatet HHMM, 0000 til 2359, "
"eller -1 for å bruke day-start-hour og day-start-minute"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:25
msgid "Workday end time for Monday"
msgstr "Sluttid for arbeidsdagen måndag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:26
msgid ""
"Time the workday ends on, in twenty four hour format HHMM, 0000 to 2359, or "
"-1 to use day-end-hour and day-end-minute"
msgstr ""
"Tidspunktet arbeidsdagen sluttar, i 24-timarsformatet HHMM, 0000 til 2359, "
"eller -1 for å bruke day-end-hour og day-end-minute"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:27
msgid "Workday start time for Tuesday"
msgstr "Starttid for arbeidsdagen tysdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:28
msgid ""
"Time the workday ends on, in twenty four hour format HHMM, 0000 to 2359, or "
"-1 to use day-start-hour and day-start-minute"
msgstr ""
"Tidspunktet arbeidsdagen sluttar, i 24-timarsformatet HHMM, 0000 til 2359, "
"eller -1 for å bruke day-start-hour og day-start-minute"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:29
msgid "Workday end time for Tuesday"
msgstr "Sluttid for arbeidsdagen tysdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:30
msgid "Workday start time for Wednesday"
msgstr "Starttid for arbeidsdagen onsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:31
msgid "Workday end time for Wednesday"
msgstr "Sluttid for arbeidsdagen onsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:32
msgid "Workday start time for Thursday"
msgstr "Starttid for arbeidsdagen torsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:33
msgid "Workday end time for Thursday"
msgstr "Sluttid for arbeidsdagen torsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:34
msgid "Workday start time for Friday"
msgstr "Starttid for arbeidsdagen fredag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:35
msgid "Workday end time for Friday"
msgstr "Sluttid for arbeidsdagen fredag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:36
msgid "Workday start time for Saturday"
msgstr "Starttid for arbeidsdagen laurdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:37
msgid "Workday end time for Saturday"
msgstr "Sluttid for arbeidsdagen laurdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:38
msgid "Workday start time for Sunday"
msgstr "Starttid for arbeidsdagen sundag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:39
msgid "Workday end time for Sunday"
msgstr "Sluttid for arbeidsdagen sundag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:40
msgid "The second timezone for a Day View"
msgstr "Den andre tidssona i dagsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:41
msgid ""
"Shows the second time zone in a Day View, if set. Value is similar to one "
"used in a “timezone” key"
msgstr ""
"Viser den andre tidssona i dagsvisinga, om ho er sett. Verdien er som den "
"som vert brukt i ein «timezone»-nøkkel"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:42
msgid "Recently used second time zones in a Day View"
msgstr "Nyleg brukte andre tidssoner i dagsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:43
msgid "List of recently used second time zones in a Day View"
msgstr "Liste over nyleg brukte andre tidssoner i dagsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:44
msgid "Maximum number of recently used timezones to remember"
msgstr "Største tal på nyleg brukte tidssoner som skal hugsast"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:45
msgid ""
"Maximum number of recently used timezones to remember in a “day-second-"
"zones” list"
msgstr ""
"Største tal på nyleg brukte tidssoner som skal hugsast i lista «day-second-"
"zones»"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:46
msgid "Default reminder value"
msgstr "Standardverdi for påminning"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:47
msgid "Number of units for determining a default reminder"
msgstr "Tal på einingar for standardpåminninga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:48
msgid "Default reminder units"
msgstr "Standard påminningseiningar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:49
msgid "Units for a default reminder, “minutes”, “hours” or “days”"
msgstr "Einingar for standardpåminninga, «minutes», «hours» eller «days»"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:50
msgid "Show categories field in the event/meeting/task editor"
msgstr "Vis kategorifeltet i redigeringa av hendingar/møte/oppgåver"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:51
msgid "Whether to show categories field in the event/meeting editor"
msgstr "Om kategorifeltet skal visast i redigeringa av hendingar/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:52
msgid "Show Role field in the event/task/meeting editor"
msgstr "Vis rollefeltet i redigeringa av hendingar/oppgåver/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:53
msgid "Whether to show role field in the event/task/meeting editor"
msgstr "Om rollefeltet skal visast i redigeringa av hendingar/oppgåver/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:54
msgid "Show RSVP field in the event/task/meeting editor"
msgstr "Vis RSVP-feltet i redigeringa av hendingar/oppgåver/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:55
msgid "Whether to show RSVP field in the event/task/meeting editor"
msgstr "Om RSVP-feltet skal visast i redigeringa av hendingar/oppgåver/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:56
msgid "Show status field in the event/task/meeting editor"
msgstr "Vis statusfeltet i redigeringa av hendingar/oppgåver/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:57
msgid "Whether to show status field in the event/task/meeting editor"
msgstr "Om statusfeltet skal visast i redigeringa av hendingar/oppgåver/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:58
msgid "Show timezone field in the event/meeting editor"
msgstr "Vis tidssonefeltet i redigeringa av hendingar/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:59
msgid "Whether to show timezone field in the event/meeting editor"
msgstr "Om tidssonefeltet skal visast i redigeringa av hendingar/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:60
msgid "Show type field in the event/task/meeting editor"
msgstr "Vis typefeltet i redigeringa av hendingar/oppgåver/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:61
msgid "Whether to show type field in the event/task/meeting editor"
msgstr "Om typefeltet skal visast i redigeringa av hendingar/oppgåver/møte"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:62
msgid "Show toolbar in the event/task/memo editor"
msgstr "Vis verktøylinje i hendings-/oppgåve-/notatredigeringa"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:63
msgid "Whether to show toolbar in the event/task/memo editor"
msgstr "Om verktøylinja skal visast i redigeringa av hendingar/oppgåver/notat"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:64
msgid "Hide completed tasks"
msgstr "Gøym fullførte oppgåver"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:65
msgid "Whether to hide completed tasks in the tasks view"
msgstr "Om fullførte oppgåver skal gøymast i oppgåvevisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:66
msgid "Hide task units"
msgstr "Gøym oppgåveeiningar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:67
msgid "Units for determining when to hide tasks, “minutes”, “hours” or “days”"
msgstr ""
"Einingar for når oppgåver skal gøymast, «minutes», «hours» eller «days»"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:68
msgid "Hide task value"
msgstr "Gøym oppgåveverdi"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:69
msgid "Number of units for determining when to hide tasks"
msgstr "Tal på einingar for når oppgåver skal gøymast"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:70
msgid "Hide cancelled events"
msgstr "Gøym avlyste hendingar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:71
msgid "Whether to hide cancelled events in the calendar view"
msgstr "Om avlyste hendingar skal gøymast i kalendervisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:72
msgid "Hide cancelled tasks"
msgstr "Gøym avlyste oppgåver"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:73
msgid "Whether to hide cancelled tasks in the tasks view"
msgstr "Om avlyste oppgåver skal gøymast i oppgåvevisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:74
msgid "Horizontal pane position"
msgstr "Plassering av vassrett felt"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:75
msgid ""
"Position of the horizontal pane, between the date navigator calendar and the "
"task list when not in the month view, in pixels"
msgstr ""
"Plasseringa til det vassrette feltet mellom datonavigatoren og oppgåvelista "
"når månadsvisinga ikkje er i bruk, i pikslar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:76
msgid "Last reminder time"
msgstr "Tidspunkt for siste påminning"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:77
msgid "Time the last reminder ran, in time_t"
msgstr "Tidspunktet då siste påminning vart køyrd, i time_t"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:78
msgid "Marcus Bains Line Color — Day View"
msgstr "Farge på Marcus Bains-linja — dagsvising"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:79
msgid "Color to draw the Marcus Bains line in the Day View"
msgstr "Farge på Marcus Bains-linja i dagsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:80
msgid "Marcus Bains Line Color — Time bar"
msgstr "Farge på Marcus Bains-linja — tidslinje"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:81
msgid "Color to draw the Marcus Bains Line in the Time bar (empty for default)"
msgstr "Farge på Marcus Bains-linja i tidslinja (tom for standard)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:82
msgid "Marcus Bains Line"
msgstr "Marcus Bains-linje"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:83
msgid ""
"Whether to draw the Marcus Bains Line (line at current time) in the calendar"
msgstr ""
"Om Marcus Bains-linja (linja ved gjeldande tid) skal teiknast i kalenderen"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:84
msgid "Memo preview pane position (horizontal)"
msgstr "Plassering av førehandsvisingsfeltet for notat (vassrett)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:85
msgid "Position of the task preview pane when oriented horizontally"
msgstr ""
"Plasseringa til førehandsvisingsfeltet for oppgåver når det er vassrett"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:86
msgid "Memo layout style"
msgstr "Oppsettstil for notat"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:87
msgid ""
"The layout style determines where to place the preview pane in relation to "
"the memo list. “0” (Classic View) places the preview pane below the memo "
"list. “1” (Vertical View) places the preview pane next to the memo list"
msgstr ""
"Oppsettstilen avgjer kvar førehandsvisingsfeltet skal plasserast i forhold "
"til notatlista. «0» (Klassisk vising) plasserer førehandsvisingsfeltet under "
"notatlista. «1» (Loddrett vising) plasserer førehandsvisingsfeltet ved sida "
"av notatlista"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:88
msgid "Memo preview pane position (vertical)"
msgstr "Plassering av førehandsvisingsfeltet for notat (loddrett)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:89
msgid "Position of the memo preview pane when oriented vertically"
msgstr "Plasseringa til førehandsvisingsfeltet for notat når det er loddrett"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:90
msgid "Month view horizontal pane position"
msgstr "Plasseringa av det vassrette feltet i månadsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:91
msgid ""
"Position of the horizontal pane, between the view and the date navigator "
"calendar and task list in the month view, in pixels"
msgstr ""
"Plasseringa til det vassrette feltet mellom visinga og datonavigatoren og "
"oppgåvelista i månadsvisinga, i pikslar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:92
msgid "Scroll Month View by a week, not by a month"
msgstr "Rull månadsvisinga ei veke om gongen, ikkje ein månad"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:93
msgid "Whether to scroll a Month View by a week, not by a month"
msgstr "Om månadsvisinga skal rullast ei veke om gongen, ikkje ein månad"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:94
msgid "Let the Month View start with the current week"
msgstr "La månadsvisinga byrje med den gjeldande veka"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:95
msgid ""
"Whether the month view should show weeks starting with the current week "
"instead of the first week of the month."
msgstr ""
"Om månadsvisinga skal vise veker frå den gjeldande veka i staden for frå den "
"første veka i månaden."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:96
msgid "Preferred New button item"
msgstr "Føretrekt element for Ny-knappen"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:97
msgid "Name of the preferred New toolbar button item"
msgstr "Namnet på det føretrekte elementet for Ny-knappen i verktøylinja"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:98
msgid "Primary calendar"
msgstr "Primær kalender"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:99
msgid ""
"The UID of the selected (or “primary”) calendar in the sidebar of the "
"“Calendar” view"
msgstr ""
"UID-en til den valde (eller «primære») kalenderen i sidepanelet i «Kalender»-"
"visinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:100
msgid "Primary memo list"
msgstr "Primær notatliste"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:101
msgid ""
"The UID of the selected (or “primary”) memo list in the sidebar of the "
"“Memos” view"
msgstr ""
"UID-en til den valde (eller «primære») notatlista i sidepanelet i «Notat»-"
"visinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:102
msgid "Primary task list"
msgstr "Primær oppgåveliste"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:103
msgid ""
"The UID of the selected (or “primary”) task list in the sidebar of the "
"“Tasks” view"
msgstr ""
"UID-en til den valde (eller «primære») oppgåvelista i sidepanelet i "
"«Oppgåver»-visinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:104
msgid "Free/busy template URL"
msgstr "Adresse til mal for ledig/oppteken"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:106
#, no-c-format
msgid ""
"The URL template to use as a free/busy data fallback, %u is replaced by the "
"user part of the mail address and %d is replaced by the domain"
msgstr ""
"URL-malen som skal brukast som reserve for ledig/oppteken-data. %u vert bytt "
"ut med brukardelen av e-postadressa, og %d med domenet"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:107
msgid "Recurrent Events in Italic"
msgstr "Gjentakande hendingar i kursiv"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:108
msgid "Show days with recurrent events in italic font in bottom left calendar"
msgstr ""
"Vis dagar med gjentakande hendingar i kursiv i kalenderen nede til venstre"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:109
msgid "Search range for time-based searching in years"
msgstr "Søkjeområde i år for tidsbasert søk"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:110
msgid ""
"How many years can the time-based search go forward or backward from "
"currently selected day when searching for another occurrence; default is ten "
"years"
msgstr ""
"Kor mange år det tidsbaserte søket kan gå fram eller tilbake frå den valde "
"dagen når det søkjer etter ein annan førekomst; standard er ti år"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:111
msgid "Show appointment end times in week and month views"
msgstr "Vis sluttidspunkt for avtalar i veke- og månadsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:112
msgid "Whether to display the end time of events in the week and month views"
msgstr "Om slutttida for hendingar skal visast i veke- og månadsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:113
msgid "Show appointment icons in the month view"
msgstr "Vis avtaleikon i månadsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:114
msgid "Whether to show icons of events in the month view"
msgstr "Om ikon for hendingar skal visast i månadsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:115
msgid "Show the memo preview pane"
msgstr "Vis førehandsvisingsfeltet for notat"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:116
msgid "If “true”, show the memo preview pane in the main window"
msgstr "Om «true», vert førehandsvisingsfeltet for notat vist i hovudvindauget"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:117
msgid "Show the task preview pane"
msgstr "Vis førehandsvisingsfeltet for oppgåver"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:118
msgid "If “true”, show the task preview pane in the main window"
msgstr ""
"Om «true», vert førehandsvisingsfeltet for oppgåver vist i hovudvindauget"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:119
msgid ""
"Show week numbers in Day View, Work Week View, Year view and Date Navigator"
msgstr ""
"Vis vekenummer i dagsvising, arbeidsvekevising, årsvising og datonavigatoren"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:120
msgid "Whether to show week numbers in various places in the Calendar"
msgstr "Om vekenummer skal visast på ulike stader i kalenderen"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:121
msgid "Vertical position for the tag pane"
msgstr "Loddrett plassering av feltet for merkelappar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:122
msgid "Show Tasks and Memos pane in the Calendar view"
msgstr "Vis feltet for oppgåver og notat i kalendervisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:123
msgid "Whether to show Tasks and Memos pane in the Calendar view"
msgstr "Om feltet for oppgåver og notat skal visast i kalendervisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:124
msgid "Highlight tasks due today"
msgstr "Uthev oppgåver med frist i dag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:125
msgid ""
"Whether highlight tasks due today with a special color (task-due-today-color)"
msgstr ""
"Om oppgåver med frist i dag skal uthevast med ein eigen farge (task-due-"
"today-color)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:126
msgid "Tasks due today color"
msgstr "Farge på oppgåver med frist i dag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:127
msgid ""
"Background color of tasks that are due today, in “#rrggbb” format. Used "
"together with task-due-today-highlight"
msgstr ""
"Bakgrunnsfarge for oppgåver med frist i dag, i formatet «#rrggbb». Vert "
"brukt saman med task-due-today-highlight"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:128
msgid "Task preview pane position (horizontal)"
msgstr "Plassering av førehandsvisingsfeltet for oppgåver (vassrett)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:129
msgid "Task layout style"
msgstr "Oppsettstil for oppgåver"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:130
msgid ""
"The layout style determines where to place the preview pane in relation to "
"the task list. “0” (Classic View) places the preview pane below the task "
"list. “1” (Vertical View) places the preview pane next to the task list"
msgstr ""
"Oppsettstilen avgjer kvar førehandsvisingsfeltet skal plasserast i forhold "
"til oppgåvelista. «0» (Klassisk vising) plasserer førehandsvisingsfeltet "
"under oppgåvelista. «1» (Loddrett vising) plasserer førehandsvisingsfeltet "
"ved sida av oppgåvelista"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:131
msgid "Task preview pane position (vertical)"
msgstr "Plassering av førehandsvisingsfeltet for oppgåver (loddrett)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:132
msgid "Position of the task preview pane when oriented vertically"
msgstr ""
"Plasseringa til førehandsvisingsfeltet for oppgåver når det er loddrett"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:133
msgid "Highlight overdue tasks"
msgstr "Uthev forseinka oppgåver"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:134
msgid ""
"Whether highlight overdue tasks with a special color (task-overdue-color)"
msgstr ""
"Om forseinka oppgåver skal uthevast med ein eigen farge (task-overdue-color)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:135
msgid "Overdue tasks color"
msgstr "Farge på forseinka oppgåver"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:136
msgid ""
"Background color of tasks that are overdue, in “#rrggbb” format. Used "
"together with task-overdue-highlight."
msgstr ""
"Bakgrunnsfarge for forseinka oppgåver, i formatet «#rrggbb». Vert brukt "
"saman med task-overdue-highlight."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:137
msgid "Time divisions"
msgstr "Oppdeling av tid"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:138
msgid "Intervals shown in Day and Work Week views, in minutes"
msgstr "Intervall som vert viste i dags- og arbeidsvekevisinga, i minutt"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:139
msgid "Timezone"
msgstr "Tidssone"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:140
msgid ""
"The default timezone to use for dates and times in the calendar, as an "
"untranslated Olson timezone database location like “America/New York”"
msgstr ""
"Standard tidssone for datoar og klokkeslett i kalenderen, som ein uomsett "
"stad i Olson-tidssonedatabasen, til dømes «America/New York»"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:141
msgid "Twenty four hour time format"
msgstr "24-timars tidsformat"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:142
msgid "Whether to show times in twenty four hour format instead of using am/pm"
msgstr "Om klokkeslett skal visast i 24-timarsformat i staden for am/pm"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:143
msgid "Birthday and anniversary reminder"
msgstr "Påminning om fødselsdagar og merkedagar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:144
msgid "Whether to set a reminder for birthdays and anniversaries"
msgstr "Om det skal setjast påminning om fødselsdagar og merkedagar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:145
msgid "Default appointment reminder"
msgstr "Standard påminning for avtalar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:146
msgid "Whether to set a default reminder for appointments"
msgstr "Om det skal setjast ei standardpåminning for avtalar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:147
msgid "Use system timezone"
msgstr "Bruk tidssona til systemet"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:148
msgid "Use the system timezone instead of the timezone selected in Evolution"
msgstr ""
"Bruk tidssona til systemet i staden for tidssona som er vald i Evolution"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:149
msgid "First day of the week"
msgstr "Første dag i veka"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:150
msgid "Use system week start day"
msgstr "Bruk første vekedag frå systemet"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:151
msgid ""
"Use the GNOME system setting for week start day, instead of the Evolution "
"own setting"
msgstr ""
"Bruk GNOME-systeminnstillinga for første vekedag i staden for innstillinga i "
"Evolution"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:152
msgid "Monday is a work day"
msgstr "Måndag er ein arbeidsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:153
msgid "Tuesday is a work day"
msgstr "Tysdag er ein arbeidsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:154
msgid "Wednesday is a work day"
msgstr "Onsdag er ein arbeidsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:155
msgid "Thursday is a work day"
msgstr "Torsdag er ein arbeidsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:156
msgid "Friday is a work day"
msgstr "Fredag er ein arbeidsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:157
msgid "Saturday is a work day"
msgstr "Laurdag er ein arbeidsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:158
msgid "Sunday is a work day"
msgstr "Sundag er ein arbeidsdag"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:159
msgid "Create events, memos and tasks as Private by default"
msgstr "Opprett hendingar, notat og oppgåver som private som standard"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:160
msgid "Draw events as flat, not shaded."
msgstr "Teikn hendingar flatt, ikkje skugga."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:161
msgid ""
"Whether to order days in the Week View from left to right, rather than from "
"top to bottom."
msgstr ""
"Om dagane i vekevisinga skal ordnast frå venstre mot høgre i staden for "
"ovanfrå og ned."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:162
msgid ""
"Allow direct edit of event Summary when clicking on it in the Day, Work "
"Week, Week or Month view."
msgstr ""
"Tillat direkte redigering av samandraget til ei hending når du klikkar på "
"det i dags-, arbeidsveke-, veke- eller månadsvisinga."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:163
msgid "User-defined reminder times, in minutes"
msgstr "Brukardefinerte påminningstider, i minutt"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:164
msgid ""
"Whether to use markdown editor for the description in the component editor."
msgstr ""
"Om du vil bruke markdown-redigering for skildringa i komponentredigeringa."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:165
msgid "Show week day names in the Year View"
msgstr "Vis namn på vekedagane i årsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:166
msgid "Show the preview pane in the Year View"
msgstr "Vis førehandsvisingsfeltet i årsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:167
msgid "If “true”, show the preview pane in the Year View"
msgstr "Om «true», vert førehandsvisingsfeltet vist i årsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:168
msgid "Year view horizontal pane position"
msgstr "Plassering av det vassrette feltet i årsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:169
msgid ""
"Position of the horizontal pane, between the year calendar and the list of "
"events for the selected day in the year view, in pixels"
msgstr ""
"Plasseringa til det vassrette feltet mellom årskalenderen og lista over "
"hendingar for den valde dagen i årsvisinga, i pikslar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:170
msgid "Layout style for the Year View"
msgstr "Oppsettstil for årsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:171
msgid ""
"The layout style determines where to place the preview pane. “0” (Horizontal "
"View) places the preview pane below the calendar. “1” (Vertical View) places "
"the preview pane next to the calendar."
msgstr ""
"Oppsettstilen avgjer kvar førehandsvisingsfeltet skal plasserast. «0» "
"(Vassrett vising) plasserer førehandsvisingsfeltet under kalenderen. «1» "
"(Loddrett vising) plasserer førehandsvisingsfeltet ved sida av kalenderen."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:172
msgid "Year view horizontal preview position"
msgstr "Vassrett plassering av førehandsvisinga i årsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:173
msgid "Position of the horizontal event preview for the year view, in pixels"
msgstr ""
"Plasseringa til den vassrette førehandsvisinga av hendingar i årsvisinga, i "
"pikslar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:174
msgid "Year view vertical preview position"
msgstr "Loddrett plassering av førehandsvisinga i årsvisinga"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:175
msgid "Position of the vertical event preview for the year view, in pixels"
msgstr ""
"Plasseringa til den loddrette førehandsvisinga av hendingar i årsvisinga, i "
"pikslar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:176
msgid "Shorten event time by minutes"
msgstr "Gjer hendingar kortare med nokre minutt"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:177
msgid ""
"By how many minutes to shorten new event time. Whether event end or start is "
"changed is determined by \"shorten-time-end\" setting"
msgstr ""
"Kor mange minutt nye hendingar skal gjerast kortare med. Om det er slutten "
"eller starten som vert endra, avgjer innstillinga «shorten-time-end»"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:178
msgid "Whether to shorten event end time"
msgstr "Om slutten av hendinga skal flyttast"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:179
msgid ""
"A pair option for \"shorten-time\" setting, to change the end time or the "
"start time"
msgstr ""
"Eit val som høyrer saman med «shorten-time», for å endre sluttida eller "
"starttida"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:180
msgid "Background color for the 'today' day"
msgstr "Bakgrunnsfarge for dagen «i dag»"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:181
msgid ""
"Leave empty to use a yellow color derived from the current theme, otherwise "
"use the color of form `#RRGGBB`"
msgstr ""
"La stå tomt for å bruke ein gul farge frå det gjeldande temaet, elles bruk "
"ein farge på forma `#RRGGBB`"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:182
msgid "Allow drag-and-drop of events in the Calendar."
msgstr "Tillat dra-og-slepp av hendingar i kalenderen."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:183
msgid ""
"This influences the Day view, the Work Week view, the Week view and the "
"Month view."
msgstr ""
"Dette gjeld dagsvisinga, arbeidsvekevisinga, vekevisinga og månadsvisinga."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:184
msgid ""
"Value to preselect when sending an event with attendees with reminders set."
msgstr ""
"Verdien som skal vere førehandsvald når du sender ei hending med deltakarar "
"og påminningar."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:185
msgid ""
"This remembers the last value of \"Send my reminders with this event\" "
"option and uses it the next time."
msgstr ""
"Dette hugsar den siste verdien for valet «Send påminningane mine med denne "
"hendinga» og brukar han neste gong."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:186
msgid "Show the day agenda in the event editor."
msgstr "Vis dagsagendaen i hendingsredigeringa."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:187
msgid "Whether the event editor shows the day agenda."
msgstr "Om hendingsredigeringa viser dagsagendaen."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:188
msgid "Position of the paned splitting the editor data and the day agenda"
msgstr "Plasseringa til skiljelinja mellom redigeringsdataa og dagsagendaen"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:189
msgid "It influences the width of the day agenda."
msgstr "Det påverkar breidda på dagsagendaen."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:190
msgid "Width of the event editor window"
msgstr "Breidda på vindauget for hendingsredigering"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:191
msgid "The editor will be opened with this width."
msgstr "Redigeringa vert opna med denne breidda."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:192
msgid "(Deprecated) First day of the week, from Sunday (0) to Saturday (6)"
msgstr "(Utdatert) Første dagen i veka, frå sundag (0) til laurdag (6)"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:193
msgid ""
"This key was deprecated in version 3.10 and should no longer be used. Use "
"“week-start-day-name” instead."
msgstr ""
"Denne nøkkelen vart forelda i versjon 3.10 og skal ikkje brukast lenger. "
"Bruk «week-start-day-name» i staden."

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:194
msgid "(Deprecated) Work days"
msgstr "(Utdatert) Arbeidsdagar"

#: ../data/org.gnome.evolution.calendar.gschema.xml.in.h:195
msgid ""
"Days on which the start and end of work hours should be indicated. (This key "
"was deprecated in version 3.10 and should no longer be used. Use the “work-"
"day-monday”, “work-day-tuesday”, etc. keys instead.)"
msgstr ""
"Dagar der starten og slutten på arbeidstida skal markerast. (Denne nøkkelen "
"vart forelda i versjon 3.10 og skal ikkje brukast lenger. Bruk nøklane «work-"
"day-monday», «work-day-tuesday» osb. i staden.)"

#: ../data/org.gnome.evolution.gschema.xml.in.h:1
msgid "Previous Evolution version"
msgstr "Førre Evolution-versjon"

#: ../data/org.gnome.evolution.gschema.xml.in.h:2
msgid ""
"The most recently used version of Evolution, expressed as "
"“major.minor.micro”. This is used for data and settings migration from older "
"to newer versions."
msgstr ""
"Den sist brukte versjonen av Evolution, skriven som «major.minor.micro». Han "
"vert brukt til å migrere data og innstillingar frå eldre til nyare versjonar."

#: ../data/org.gnome.evolution.gschema.xml.in.h:3
msgid "List of disabled plugins"
msgstr "Liste over tillegg som er slått av"

#: ../data/org.gnome.evolution.gschema.xml.in.h:4
msgid "The list of disabled plugins in Evolution"
msgstr "Lista over tillegg som er slått av i Evolution"

#: ../data/org.gnome.evolution.gschema.xml.in.h:5
msgid "The window’s X coordinate"
msgstr "X-koordinaten til vindauget"

#: ../data/org.gnome.evolution.gschema.xml.in.h:6
msgid "The window’s Y coordinate"
msgstr "Y-koordinaten til vindauget"

#: ../data/org.gnome.evolution.gschema.xml.in.h:7
msgid "The window’s width in pixels"
msgstr "Breidda på vindauget i pikslar"

#: ../data/org.gnome.evolution.gschema.xml.in.h:8
msgid "The window’s height in pixels"
msgstr "Høgda på vindauget i pikslar"

#: ../data/org.gnome.evolution.gschema.xml.in.h:9
msgid "Whether the window is maximized"
msgstr "Om vindauget er maksimert"

#: ../data/org.gnome.evolution.importer.gschema.xml.in.h:1
msgid "GNOME Calendar’s calendar import done"
msgstr "Kalenderimporten frå GNOME-kalenderen er ferdig"

#: ../data/org.gnome.evolution.importer.gschema.xml.in.h:2
msgid "Whether calendar from GNOME Calendar has been imported or not"
msgstr "Om kalenderen frå GNOME-kalenderen er importert eller ikkje"

#: ../data/org.gnome.evolution.importer.gschema.xml.in.h:3
msgid "GNOME Calendar’s tasks import done"
msgstr "Oppgåveimporten frå GNOME-kalenderen er ferdig"

#: ../data/org.gnome.evolution.importer.gschema.xml.in.h:4
msgid "Whether tasks from GNOME Calendar have been imported or not"
msgstr "Om oppgåver frå GNOME-kalender har vorte importerte eller ikkje"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:1
msgid "Check whether Evolution is the default mailer"
msgstr "Sjekk om Evolution er standard e-postprogram"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:2
msgid ""
"Every time Evolution starts, check whether or not it is the default mailer."
msgstr "Sjå kvar gong Evolution startar om det er standard e-postprogram."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:3
msgid "Default charset in which to compose messages"
msgstr "Standard teiknsett for skriving av meldingar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:4
msgid "Default charset in which to compose messages. Uses UTF-8, if not set."
msgstr ""
"Standard teiknsett for å skrive meldingar. Brukar UTF-8 viss det ikkje er "
"sett."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:5
msgid "Comma-separated names of the editor to prefer in the message composer"
msgstr ""
"Namn på redigeringsprogramma som skal føretrekkjast i meldingsredigeringa, "
"skilde med komma"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:6
msgid ""
"If the name doesn’t correspond to any known editor, then the built-in WebKit "
"editor is used. The mode is optional, in which case the editor is used for "
"all the modes it supports. Modes are “plain”, “html”, \"markdown-plain\", "
"\"markdown-html\" and \"markdown\". Example values: “webkit” (to use WebKit "
"for plain and html), “plain:first-editor,html:second-editor” (to use “first-"
"editor” for the “plain” and “second-editor” for “html”)"
msgstr ""
"Om namnet ikkje svarar til nokon kjend redigerar, vert den innebygde WebKit-"
"redigeraren brukt. Modusen er valfri, og utan han vert redigeraren brukt for "
"alle modusane han støttar. Modusane er «plain», «html», \"markdown-plain\", "
"\"markdown-html\" og \"markdown\". Dømeverdiar: «webkit» (for å bruke WebKit "
"for plain og html), «plain:first-editor,html:second-editor» (for å bruke "
"«first-editor» for «plain» og «second-editor» for «html»)"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:7
msgid "Path where picture gallery should search for its content"
msgstr "Sti der biletgalleriet skal leite etter innhaldet sitt"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:8
msgid ""
"This value can be an empty string, which means it’ll use the system Picture "
"folder, usually set to ~/Pictures. This folder will be also used when the "
"set path is not pointing to the existent folder"
msgstr ""
"Denne verdien kan vere ein tom streng, og då vert biletmappa til systemet "
"brukt, vanlegvis ~/Pictures. Denne mappa vert òg brukt når den valde stien "
"ikkje peikar til ei mappe som finst"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:9
msgid "Spell check inline"
msgstr "Stavekontroll undervegs"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:10
msgid "Draw spelling error indicators on words as you type."
msgstr "Marker stavefeil i orda medan du skriv."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:11
msgid "Automatic link recognition"
msgstr "Kjenn att lenkjer automatisk"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:12
msgid "Recognize links in text and replace them."
msgstr "Kjenn att lenkjer i teksten, og byt dei ut."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:13
msgid "Automatic emoticon recognition"
msgstr "Kjenn att smilefjes automatisk"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:14
msgid ""
"Recognize emoticons in text and replace them with images or Unicode "
"characters."
msgstr ""
"Kjenn att smilefjes i tekst og byt dei ut med bilete eller Unicode-teikn."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:15
msgid "Unicode emoticons"
msgstr "Unicode-smilefjes"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:16
msgid "Use Unicode characters for emoticons."
msgstr "Bruk Unicode-teikn for smilefjes."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:17
msgid "Attribute message"
msgstr "Tilskrivingsmelding"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:18
msgid ""
"The text that is inserted when replying to a message, attributing the "
"message to the original author"
msgstr ""
"Teksten som vert sett inn når du svarar på ei melding, og som viser kven som "
"opphavleg skreiv meldinga"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:19
msgid "Forward message"
msgstr "Vidaresend melding"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:20
msgid ""
"The text that is inserted when forwarding a message, saying that the "
"forwarded message follows"
msgstr ""
"Teksten som vert sett inn når du vidaresender ei melding, og som seier at "
"den vidaresende meldinga følgjer"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:21
msgid "Original message"
msgstr "Opphavleg melding"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:22
msgid ""
"The text that is inserted when replying to a message (top posting), saying "
"that the original message follows"
msgstr ""
"Teksten som vert sett inn når du svarar på ei melding (toppsvar), og som "
"seier at den opphavlege meldinga følgjer"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:23
msgid "Group Reply replies to list"
msgstr "Gruppesvar svarar til lista"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:24
msgid ""
"Instead of the normal “Reply to All” behaviour, this option will make the "
"“Group Reply” toolbar button try to reply only to the mailing list through "
"which you happened to receive the copy of the message to which you’re "
"replying."
msgstr ""
"I staden for den vanlege «Svar til alle»-åtferda gjer dette valet at "
"«Gruppesvar»-knappen prøver å svare berre til e-postlista du fekk kopien av "
"meldinga frå."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:25
msgid "Put the cursor at the bottom of replies"
msgstr "Set markøren nedst i svara"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:26
msgid ""
"Users get all up in arms over where the cursor should go when replying to a "
"message. This determines whether the cursor is placed at the top of the "
"message or the bottom."
msgstr ""
"Brukarar er svært usamde om kvar markøren skal stå når ein svarar på ei "
"melding. Dette avgjer om markøren vert plassert øvst eller nedst i meldinga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:27
msgid "Always request read receipt"
msgstr "Alltid be om lesekvittering"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:28
msgid "Whether a read receipt request gets added to every message by default."
msgstr "Om det skal bedast om lesekvittering i alle meldingar som standard."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:29
msgid "Always request Delivery Status Notification"
msgstr "Be alltid om leveringsstatusvarsel"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:30
msgid ""
"Whether a Delivery Status Notification request gets added to every message "
"by default."
msgstr ""
"Om det skal bedast om leveringsstatusvarsel i alle meldingar som standard."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:31
msgid "What mode open the composer with"
msgstr "Kva modus meldingsredigeringa skal opne i"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:32
msgid "Spell checking languages"
msgstr "Språk for stavekontroll"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:33
msgid "List of dictionary language codes used for spell checking."
msgstr "Liste over språkkodar for ordbøkene som vert brukte til stavekontroll."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:34
msgid "List of recently used spell checking languages"
msgstr "Liste over språk som nyleg har vorte brukte til stavekontroll"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:35
msgid ""
"List of dictionary language codes used for spell checking, which had been "
"used recently."
msgstr ""
"Liste over språkkodar for ordbøker som nyleg er brukte til stavekontroll."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:36
msgid "How many recently used spell checking languages to remember"
msgstr "Kor mange nyleg brukte stavekontrollspråk som skal hugsast"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:37
msgid "Show “Bcc” field when sending a mail message"
msgstr "Vis «Bcc»-feltet når du sender e-post"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:38
msgid ""
"Show the “Bcc” field when sending a mail message. This is controlled from "
"the View menu when a mail account is chosen."
msgstr ""
"Vis «Bcc»-feltet når du sender e-post. Dette vert styrt frå Vis-menyen når "
"ein e-postkonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:39
msgid "Show “Cc” field when sending a mail message"
msgstr "Vis «Cc»-feltet når du sender e-post"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:40
msgid ""
"Show the “Cc” field when sending a mail message. This is controlled from the "
"View menu when a mail account is chosen."
msgstr ""
"Vis «Cc»-feltet når du sender e-post. Dette vert styrt frå Vis-menyen når "
"ein e-postkonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:41
msgid "Show “From” override field when sending a mail message"
msgstr "Vis «Frå»-overstyringsfeltet når du sender e-post"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:42
msgid ""
"Show the “From” override field when sending a mail message. This is "
"controlled from the View menu when a mail account is chosen."
msgstr ""
"Vis overstyringsfeltet for «Frå» når du sender e-post. Dette vert styrt frå "
"Vis-menyen når ein e-postkonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:43
msgid "Show “Reply To” field when sending a mail message"
msgstr "Vis «Svar til»-feltet når du sender e-post"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:44
msgid ""
"Show the “Reply To” field when sending a mail message. This is controlled "
"from the View menu when a mail account is chosen."
msgstr ""
"Vis «Svar til»-feltet når du sender e-post. Dette vert styrt frå Vis-menyen "
"når ein e-postkonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:45
msgid "Show “Mail-Followup-To” field when sending a mail message"
msgstr "Vis «Mail-Followup-To»-feltet når du sender e-post"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:46
msgid ""
"Show the “Mail-Followup-To” field when sending a mail message. This is "
"controlled from the View menu when a mail account is chosen."
msgstr ""
"Vis «Mail-Followup-To»-feltet når du sender e-post. Dette vert styrt frå Vis-"
"menyen når ein e-postkonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:47
msgid "Show “Mail-Reply-To” field when sending a mail message"
msgstr "Vis «Mail-Reply-To»-feltet når du sender e-post"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:48
msgid ""
"Show the “Mail-Reply-To” field when sending a mail message. This is "
"controlled from the View menu when a mail account is chosen."
msgstr ""
"Vis «Mail-Reply-To»-feltet når du sender e-post. Dette vert styrt frå Vis-"
"menyen når ein e-postkonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:49
msgid "Show “From” field when posting to a newsgroup"
msgstr "Vis «Frå»-feltet når du postar i ei nyheitsgruppe"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:50
msgid ""
"Show the “From” field when posting to a newsgroup. This is controlled from "
"the View menu when a news account is chosen."
msgstr ""
"Vis «Frå»-feltet når du postar til ei nyheitsgruppe. Dette vert styrt frå "
"Vis-menyen når ein nyheitskonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:51
msgid "Show “Reply To” field when posting to a newsgroup"
msgstr "Vis «Svar til»-feltet når du postar i ei nyheitsgruppe"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:52
msgid ""
"Show the “Reply To” field when posting to a newsgroup. This is controlled "
"from the View menu when a news account is chosen."
msgstr ""
"Vis «Svar til»-feltet når du postar til ei nyheitsgruppe. Dette vert styrt "
"frå Vis-menyen når ein nyheitskonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:53
msgid "Show “Mail-Followup-To” field when posting to a newsgroup"
msgstr "Vis «Mail-Followup-To»-feltet når du postar til ei nyheitsgruppe"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:54
msgid ""
"Show the “Mail-Followup-To” field when posting to a newsgroup. This is "
"controlled from the View menu when a news account is chosen."
msgstr ""
"Vis «Mail-Followup-To»-feltet når du postar til ei nyheitsgruppe. Dette vert "
"styrt frå Vis-menyen når ein nyheitskonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:55
msgid "Show “Mail-Reply-To” field when posting to a newsgroup"
msgstr "Vis «Mail-Reply-To»-feltet når du postar til ei nyheitsgruppe"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:56
msgid ""
"Show the “Mail-Reply-To” field when posting to a newsgroup. This is "
"controlled from the View menu when a news account is chosen."
msgstr ""
"Vis «Mail-Reply-To»-feltet når du postar til ei nyheitsgruppe. Dette vert "
"styrt frå Vis-menyen når ein nyheitskonto er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:57
msgid "Digitally sign replies when the original message is signed"
msgstr "Signer svar digitalt når den opphavlege meldinga er signert"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:58
msgid ""
"Automatically enable PGP or S/MIME signatures when replying to a message "
"which is also PGP or S/MIME signed."
msgstr ""
"Slå automatisk på PGP- eller S/MIME-signaturar når du svarar på ei melding "
"som også er PGP- eller S/MIME-signert."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:59
msgid "Encode filenames in an Outlook/GMail way"
msgstr "Kod filnamn slik Outlook og GMail gjer"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:60
msgid ""
"Encode filenames in the mail headers same as Outlook or GMail do, to let "
"them display correctly filenames with UTF-8 letters sent by Evolution, "
"because they do not follow the RFC 2231, but use the incorrect RFC 2047 "
"standard."
msgstr ""
"Kod filnamn i meldingshovuda slik Outlook og GMail gjer, så dei viser "
"filnamn med UTF-8-teikn frå Evolution rett. Dei følgjer ikkje RFC 2231, men "
"brukar den ukorrekte RFC 2047-standarden."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:61
msgid "Send messages through Outbox folder"
msgstr "Send meldingar gjennom Utboks-mappa"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:62
msgid ""
"Always save messages to Outbox folder when sending, to let a user choose "
"when the messages should be sent."
msgstr ""
"Lagre alltid meldingar i Utboks-mappa ved sending, så brukaren kan velje når "
"meldingane skal sendast."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:63
msgid ""
"How long to delay Outbox flush when sending messages through Outbox folder"
msgstr ""
"Kor lenge tømminga av Utboks skal vente når meldingar vert sende gjennom "
"Utboks-mappa"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:64
msgid ""
"A delay, in minutes, to wait for the Outbox folder flush. Less than 0 means "
"never flush, 0 means immediately, the rest is the delay interval in minutes."
msgstr ""
"Kor mange minutt tømminga av Utboks-mappa skal vente. Mindre enn 0 tyder "
"aldri, 0 tyder med ein gong, og andre verdiar er ventetida i minutt."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:65
msgid "Include signature in new messages only"
msgstr "Ta med signatur berre i nye meldingar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:66
msgid ""
"Include selected signature only for new messages, but have no signature "
"added for Replies or Forwards."
msgstr ""
"Ta berre med den valde signaturen i nye meldingar, ikkje i svar eller "
"vidaresendingar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:67
msgid "Put personalized signatures at the top of replies"
msgstr "Set personlege signaturar øvst i svar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:68
msgid ""
"Users get all up in arms over where their signature should go when replying "
"to a message. This determines whether the signature is placed at the top of "
"the message or the bottom."
msgstr ""
"Brukarar er svært usamde om kvar signaturen skal stå når ein svarar på ei "
"melding. Dette avgjer om signaturen vert plassert øvst eller nedst i "
"meldinga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:69
msgid "Do not add signature delimiter"
msgstr "Ikkje legg til signaturskiljeteikn"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:70
msgid ""
"Set to TRUE in case you do not want to add signature delimiter before your "
"signature when composing a mail."
msgstr ""
"Set til TRUE om du ikkje vil ha signaturskiljeteiknet framfor signaturen når "
"du skriv e-post."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:71
msgid "Keep original message signature in replies"
msgstr "Behald signaturen frå den opphavlege meldinga i svar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:72
msgid ""
"When set to TRUE, keep original message signature in replies, otherwise "
"strip the signature and everything below it when replying to the message."
msgstr ""
"Når dette er sett til TRUE, vert signaturen i den opphavlege meldinga "
"behalden i svar, elles vert signaturen og alt under han fjerna når du svarar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:73
msgid "Ignore list Reply-To:"
msgstr "Oversjå Reply-To: frå lister"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:74
msgid ""
"Some mailing lists set a Reply-To: header to trick users into sending "
"replies to the list, even when they ask Evolution to make a private reply. "
"Setting this option to TRUE will attempt to ignore such Reply-To: headers, "
"so that Evolution will do as you ask it. If you use the private reply "
"action, it will reply privately, while if you use the “Reply to List” action "
"it will do that. It works by comparing the Reply-To: header with a List-"
"Post: header, if there is one."
msgstr ""
"Nokre e-postlister set eit Reply-To:-hovud for å lure brukarar til å svare "
"til lista, sjølv når dei ber Evolution om å svare privat. Set du dette valet "
"til TRUE, prøver Evolution å oversjå slike Reply-To:-hovud, slik at det gjer "
"som du ber om. Brukar du handlinga for privat svar, vert svaret privat, og "
"brukar du «Svar til lista», går svaret til lista. Dette fungerer ved å "
"samanlikne Reply-To:-hovudet med eit List-Post:-hovud, om det finst."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:75
msgid "List of localized “Re”"
msgstr "Liste over lokaliserte «Re»"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:76
msgid ""
"Comma-separated list of localized “Re” abbreviations to skip in a subject "
"text when replying to a message, as an addition to the standard “Re” prefix. "
"An example is “SV,AV”."
msgstr ""
"Kommaskild liste over lokaliserte «Re»-forkortingar som skal hoppast over i "
"emnet når du svarar på ei melding, i tillegg til standardprefikset «Re». Eit "
"døme er «SV,AV»."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:77
msgid "List of localized “Re” separators"
msgstr "Liste over lokaliserte «Re»-skiljeteikn"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:78
msgid ""
"A list of localized “Re” separators, used to skip in a subject text when "
"replying to a message, as an addition to the standard “:” and the Unicode "
"“︰” separators."
msgstr ""
"Ei liste over lokaliserte «Re»-skiljeteikn som skal hoppast over i emnet når "
"du svarar på ei melding, i tillegg til standardskiljeteikna «:» og "
"Unicode-«︰»."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:79
msgid "Use localized “Fwd”/“Re” in message Subject"
msgstr "Bruk lokaliserte «Fwd»/«Re» i emnet"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:80
msgid ""
"When set to true, uses localized “Fwd”/“Re” in message Subject on reply and "
"forward as provided by current locale translation, otherwise uses "
"unlocalized version."
msgstr ""
"Når dette er sett til true, vert lokaliserte «Fwd»/«Re» frå den gjeldande "
"omsetjinga brukte i emnet ved svar og vidaresending, elles vert den "
"ulokaliserte versjonen brukt."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:81
msgid "Number of characters for wrapping"
msgstr "Tal på teikn før linjebryting"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:82
msgid "Will autowrap lines after given number of characters."
msgstr "Bryt linjer automatisk etter det gjevne talet på teikn."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:83
msgid ""
"Number of To and CC recipients to ask “prompt-on-many-to-cc-recips” from"
msgstr "Tal på Til- og Cc-mottakarar før «prompt-on-many-to-cc-recips» spør"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:84
msgid ""
"When to ask, when the number of To and CC recipients reaches this value."
msgstr ""
"Når det skal spørjast: når talet på Til- og Cc-mottakarar når denne verdien."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:85
msgid "Whether to always show main toolbar"
msgstr "Om hovudverktøylinja alltid skal visast"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:86
msgid "If set to “true”, the main toolbar will be visible."
msgstr "Om dette er sett til «true», er hovudverktøylinja synleg."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:87
msgid "Whether to always show edit toolbar"
msgstr "Om redigeringsverktøylinja alltid skal visast"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:88
msgid "If set to “true”, the edit toolbar will be visible."
msgstr "Om dette er sett til «true», er redigeringsverktøylinja synleg."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:89
msgid "Whether to always show Sign and Encrypt buttons on the toolbar"
msgstr "Om knappane Signer og Krypter alltid skal visast i verktøylinja"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:90
msgid ""
"If set to “true”, the Sign and Encrypt buttons for either PGP or S/MIME are "
"always shown in the composer’s toolbar. Otherwise they are shown only when "
"being used."
msgstr ""
"Om dette er sett til «true», vert knappane Signer og Krypter for PGP eller S/"
"MIME alltid viste i verktøylinja i meldingsredigeringa. Elles vert dei berre "
"viste når dei er i bruk."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:91
msgid "Wrap quoted text in replies"
msgstr "Bryt sitert tekst i svar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:92
msgid "If set to “true” quoted text in replies will be wrapped."
msgstr "Om dette er sett til «true», vert sitert tekst i svar broten."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:93
msgid "Paste plain text as preformatted"
msgstr "Lim inn rein tekst som førehandsformatert"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:94
msgid ""
"When set, paste a plain text into the composer body as Preformatted "
"paragraph. When not set, paste it as Normal paragraph."
msgstr ""
"Når dette er sett, vert rein tekst limt inn i meldingskroppen som eit "
"førehandsformatert avsnitt. Elles vert han limt inn som eit vanleg avsnitt."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:95
msgid "Convert UTC time in reply credits to local time"
msgstr "Konverter UTC-tid i svarlina til lokal tid"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:96
msgid ""
"Whether the time in reply credits should be converted to local time when "
"it’s in UTC in the message."
msgstr ""
"Om tida i svarlina skal konverterast til lokal tid når ho står i UTC i "
"meldinga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:97
msgid "Convert time in reply credits to local time"
msgstr "Konverter tida i svarlina til lokal tid"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:98
msgid ""
"Whether the time in reply credits should be converted to local time. This "
"converts any time, not only UTC times, for which “composer-reply-credits-utc-"
"to-localtime” can be used."
msgstr ""
"Om tida i svarlina skal konverterast til lokal tid. Dette konverterer alle "
"tider, ikkje berre UTC-tider, som «composer-reply-credits-utc-to-localtime» "
"kan brukast til."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:99
msgid "Use user date format in reply credits"
msgstr "Bruk datoformatet til brukaren i svarlina"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:100
msgid ""
"Whether the date in reply credits should be shown in the user date format. "
"If unset, shows the header value from the original message."
msgstr ""
"Om datoen i svarlina skal visast i datoformatet til brukaren. Om ikkje, vert "
"verdien frå meldingshovudet i den opphavlege meldinga vist."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:101
msgid "Mark replied to messages as read"
msgstr "Merk meldingar som er svarte på, som lesne"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:102
msgid ""
"When replying to a message and marking it as being replied to, then whether "
"also mark it as read."
msgstr ""
"Om ei melding òg skal merkast som lesen når du svarar på ho og ho vert merkt "
"som svart på."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:103
msgid "Whether start Plain Text composer with Preformatted paragraph mode"
msgstr ""
"Om redigering i rein tekst skal starte med førehandsformatert avsnittsmodus"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:104
msgid ""
"When set to true, new Plain Text messages will have preselected Preformatted "
"paragraph mode. The Normal paragraph mode will be used when set to false."
msgstr ""
"Når dette er sett til true, får nye meldingar i rein tekst "
"førehandsformatert avsnittsmodus som førehandsval. Vanleg avsnittsmodus vert "
"brukt når det er sett til false."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:105
msgid "Whether to obey Content-Disposition:inline message header hint"
msgstr "Om hintet Content-Disposition:inline i meldingshovudet skal følgjast"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:106
msgid ""
"Set to “false” to block automatic display of attachments with Content-"
"Disposition: inline."
msgstr ""
"Set til «false» for å blokkere automatisk vising av vedlegg med Content-"
"Disposition: inline."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:107
msgid "Save file format for drag-and-drop operation"
msgstr "Lagre filformat for dra-og-slepp-operasjon"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:108
msgid ""
"Can be either “mbox”, “eml” or “pdf”. The “eml” can switch to the “mbox” "
"when there is more than one message selected."
msgstr ""
"Kan vere «mbox», «eml» eller «pdf». «eml» kan bytast til «mbox» når meir enn "
"éi melding er vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:109
msgid "Show image animations"
msgstr "Vis bileteanimasjonar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:110
msgid ""
"Enable animated images in HTML mail. Many users find animated images "
"annoying and prefer to see a static image instead."
msgstr ""
"Slå på animerte bilete i HTML-e-post. Mange brukarar synest animerte bilete "
"er irriterande og vil heller sjå eit statisk bilete."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:111
msgid "Enable or disable type ahead search feature"
msgstr "Slå sanntidssøk av eller på"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:112
msgid ""
"Enable the sidebar search feature to allow interactive searching of folder "
"names."
msgstr "Slå på søkjefunksjonen i sidepanelet for interaktivt søk i mappenamn."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:113
msgid "Enable or disable magic space bar"
msgstr "Slå magisk mellomromstast av eller på"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:114
msgid ""
"Enable this to use Space bar key to scroll in message preview, message list "
"and folders."
msgstr ""
"Slå på for å bruke mellomromstasten til å rulle i førehandsvisinga av "
"meldingar, meldingslista og mappene."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:115
msgid "Enable to use a similar message list view settings for all folders"
msgstr ""
"Slå på for å bruke dei same innstillingane for visinga av meldingslista i "
"alle mapper"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:116
msgid "Enable to use a similar message list view settings for all folders."
msgstr ""
"Slå på for å bruke dei same innstillingane for visinga av meldingslista i "
"alle mapper."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:117
msgid "Enable to use the same search settings for all folders"
msgstr "Slå på for å bruke dei same søkjeinnstillingane i alle mapper"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:118
msgid "This is considered only in combination with the 'global-view-setting'."
msgstr "Dette vert berre teke omsyn til saman med 'global-view-setting'."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:119
msgid "Mark citations in the message “Preview”"
msgstr "Marker sitat i «Førehandsvising» av meldinga"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:120
msgid "Mark citations in the message “Preview”."
msgstr "Marker sitat i «Førehandsvising» av meldinga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:121
msgid "Citation highlight color"
msgstr "Farge for utheving av sitat"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:122
msgid "Citation highlight color."
msgstr "Farge for utheving av sitat."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:123
msgid "Enable/disable caret mode"
msgstr "Slå markørmodus av/på"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:124
msgid "Enable caret mode, so that you can see a cursor when reading mail."
msgstr "Bruk markørmodus, slik at du ser ein markør når du les e-post."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:125
msgid "Default charset in which to display messages"
msgstr "Standard teiknsett for vising av meldingar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:126
msgid "Default charset in which to display messages."
msgstr "Standard teiknsett for vising av meldingar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:127
msgid "Automatically load images for HTML messages over HTTP"
msgstr "Last bilete i HTML-meldingar automatisk over HTTP"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:128
msgid "Show notification about missing remote content"
msgstr "Vis varsel om eksternt innhald som manglar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:129
msgid ""
"When the message preview shows a message which requires to download remote "
"content, while the download is not allowed for the user or the site, then "
"show a notification about it on top of the preview panel."
msgstr ""
"Når førehandsvisinga viser ei melding som krev nedlasting av eksternt "
"innhald, men nedlasting ikkje er tillaten for brukaren eller nettstaden, "
"vert det vist eit varsel om det øvst i førehandsvisingspanelet."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:130
msgid "Show Animations"
msgstr "Vis animasjonar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:131
msgid "Show animated images as animations."
msgstr "Vis animerte bilete som animasjonar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:132
msgid "Show all message headers"
msgstr "Vis alle meldingshovud"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:133
msgid "Show all the headers when viewing a messages."
msgstr "Vis alle meldingshovuda når du ser på ei melding."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:134
msgid "List of headers to show when viewing a message."
msgstr "Liste over meldingshovud som skal visast når du ser på ei melding."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:135
msgid ""
"Each header is represented as a pair: the header name, and a boolean "
"indicating whether the header is enabled. Disabled headers are not shown "
"when viewing a message, but are still listed in Preferences."
msgstr ""
"Kvart meldingshovud er eit par: namnet på hovudet og ein boolsk verdi som "
"seier om hovudet er slått på. Hovud som er slått av, vert ikkje viste når du "
"ser på ei melding, men står framleis i Innstillingar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:136
msgid "Show photo of the sender"
msgstr "Vis bilete av avsendaren"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:137
msgid "Show the photo of the sender in the message reading pane."
msgstr "Vis biletet av avsendaren i lesefeltet for meldingar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:138
msgid "Search libravatar.org for photo of the sender"
msgstr "Søk etter bilete av avsendaren på libravatar.org"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:139
msgid "Allow searching also at libravatar.org for photo of the sender."
msgstr "Tillat søk etter bilete av avsendaren òg på libravatar.org."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:140
msgid "Mark as Seen after specified timeout"
msgstr "Merk som lesen etter ei gjeven tid"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:141
msgid "Mark as Seen after specified timeout."
msgstr "Merk som lesen etter ei gjeven tid."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:142
msgid "Mark as Seen always after specified timeout"
msgstr "Merk alltid som lesen etter ei gjeven tid"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:143
msgid ""
"If set to true, the selected message will be set as unread after the timeout "
"also after the folder change."
msgstr ""
"Om dette er sett til true, vert den valde meldinga merkt som lesen etter "
"tidsavbrotet, òg etter at du har bytt mappe."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:144
msgid "Timeout for marking messages as seen"
msgstr "Tidsavbrot før meldingar vert merkte som lesne"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:145
msgid "Timeout in milliseconds for marking messages as seen."
msgstr "Tidsavbrot i millisekund før meldingar vert merkte som lesne."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:146
msgid "Show Attachment Bar"
msgstr "Vis vedleggsfeltet"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:147
msgid ""
"Show Attachment Bar below the message preview pane when the message has "
"attachments."
msgstr ""
"Vis vedleggsfeltet under førehandsvisingsfeltet når meldinga har vedlegg."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:148
msgid "Sender email-address column in the message list"
msgstr "Kolonne for e-postadressa til avsendaren i meldingslista"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:149
msgid ""
"Show the email-address of the sender in a separate column in the message "
"list."
msgstr "Vis e-postadressa til avsendaren i ein eigen kolonne i meldingslista."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:150
msgid "Show deleted messages in the message-list"
msgstr "Vis sletta meldingar i meldingslista"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:151
msgid "Show deleted messages (with a strike-through) in the message-list."
msgstr "Vis sletta meldingar (gjennomstreka) i meldingslista."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:152
msgid "Show junk messages in the message-list"
msgstr "Vis søppelpost i meldingslista"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:153
msgid "Show junk messages (with a red strike-through) in the message-list."
msgstr "Vis søppelpost (med raud gjennomstreking) i meldingslista."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:154
msgid "Hides the per-folder preview and removes the selection"
msgstr "Gøymer førehandsvisinga for kvar mappe og fjernar utvalet"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:155
msgid ""
"This key is read only once and reset to “false” after read. This unselects "
"the mail in the list and removes the preview for that folder."
msgstr ""
"Denne nøkkelen vert berre lesen éin gong og nullstilt til «false» etterpå. "
"Då vert valet av e-posten i lista fjerna, og førehandsvisinga for mappa vert "
"fjerna."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:156
msgid "Height of the message-list pane"
msgstr "Høgda på meldingslistefeltet"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:157
msgid "Height of the message-list pane."
msgstr "Høgda på meldingslistefeltet."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:158
msgid "Whether message headers are collapsed in the user interface"
msgstr "Om meldingshovuda er falda saman i brukargrensesnittet"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:159
msgid "Width of the message-list pane"
msgstr "Breidda på meldingslistefeltet"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:160
msgid "Width of the message-list pane."
msgstr "Breidda på meldingslistefeltet."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:161
msgid "Layout style"
msgstr "Oppsettstil"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:162
msgid ""
"The layout style determines where to place the preview pane in relation to "
"the message list. “0” (Classic View) places the preview pane below the "
"message list. “1” (Vertical View) places the preview pane next to the "
"message list."
msgstr ""
"Oppsettstilen avgjer kvar førehandsvisingsfeltet skal plasserast i forhold "
"til meldingslista. «0» (Klassisk vising) plasserer førehandsvisingsfeltet "
"under meldingslista. «1» (Loddrett vising) plasserer førehandsvisingsfeltet "
"ved sida av meldingslista."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:163
msgid "Variable width font"
msgstr "Skrifttype med variabel breidde"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:164
msgid "The variable width font for mail display."
msgstr "Skrifttype med variabel breidde brukt til å vise e-post."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:165
msgid "Terminal font"
msgstr "Terminalskrifttype"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:166
msgid "The terminal font for mail display."
msgstr "Terminalskrifttypen brukt til å vise e-post."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:167
msgid "Use custom fonts"
msgstr "Bruk eigne skrifttypar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:168
msgid "Use custom fonts for displaying mail."
msgstr "Bruk eigne skrifttypar til å vise e-post."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:169
msgid "Compress display of addresses in TO/CC/BCC"
msgstr "Komprimer adresser i Til/Cc/Bcc"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:170
msgid ""
"Compress display of addresses in TO/CC/BCC to the number specified in "
"address_count."
msgstr ""
"Komprimer adresser i Til/Cc/Bcc til talet som er oppgjeve i address_count."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:171
msgid "Number of addresses to display in TO/CC/BCC"
msgstr "Tal på adresser som skal visast i Til/Cc/Bcc"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:172
msgid ""
"This sets the number of addresses to show in default message list view, "
"beyond which a “...” is shown."
msgstr ""
"Dette set kor mange adresser som skal visast i standardvisinga av "
"meldingslista før «...» vert vist."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:173
msgid ""
"Show mails in headers part of the message preview when name is available"
msgstr ""
"Vis e-postadresser i hovuddelen av førehandsvisinga når namnet er kjent"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:174
msgid ""
"When set to false, the mail addresses which contain both the name and the "
"email parts in headers like To/Cc/Bcc will be shown only with the name part, "
"without the actual email, with the name made clickable."
msgstr ""
"Når dette er sett til false, vert e-postadresser som har både namn og "
"adresse i hovud som To/Cc/Bcc, berre viste med namnet, utan sjølve adressa, "
"og namnet kan klikkast på."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:175
msgid "Thread the message-list based on Subject"
msgstr "Sorter meldingslista i trådar etter emne"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:176
msgid ""
"Whether or not to fall back on threading by subjects when the messages do "
"not contain In-Reply-To or References headers."
msgstr ""
"Om meldingslista skal trådast etter emne når meldingane ikkje inneheld In-"
"Reply-To eller References i meldingshovudet."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:177
msgid "Default value for thread expand state"
msgstr "Standardverdi for trådutvidingstilstand"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:178
msgid ""
"This setting specifies whether the threads should be in expanded or "
"collapsed state by default. Evolution requires a restart."
msgstr ""
"Denne innstillinga avgjer om trådane skal vere utfalda eller samanfalda som "
"standard. Evolution må startast på nytt."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:179
msgid "Whether sort threads based on latest message in that thread"
msgstr "Om trådar skal sorterast etter den siste meldinga i tråden"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:180
msgid ""
"This setting specifies whether the threads should be sorted based on latest "
"message in each thread, rather than by message’s date. Evolution requires a "
"restart."
msgstr ""
"Denne innstillinga avgjer om trådane skal sorterast etter den siste meldinga "
"i kvar tråd i staden for etter datoen til meldinga. Evolution må startast på "
"nytt."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:181
msgid "Whether sort thread children always ascending"
msgstr "Om svar i trådar alltid skal sorterast stigande"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:182
msgid ""
"This setting specifies whether the thread children should be sorted always "
"ascending, rather than using the same sort order as in the thread root level."
msgstr ""
"Denne innstillinga avgjer om svara i ein tråd alltid skal sorterast stigande "
"i staden for i same rekkjefølgje som på øvste nivå i tråden."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:183
msgid "Whether to compress thread level"
msgstr "Om trådnivå skal komprimerast"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:184
msgid ""
"Set to true to compress thread levels for flat conversations, to make the "
"level not so deep."
msgstr ""
"Set til true for å komprimere trådnivåa i flate samtalar, slik at nivåa "
"ikkje vert så djupe."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:185
msgid "Whether to generate flat threads"
msgstr "Om det skal lagast flate trådar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:186
msgid ""
"Set to true to generate flat threads. That is, the thread will have only one "
"level, with no sublevels."
msgstr ""
"Set til true for å lage flate trådar. Det vil seie at tråden berre har eitt "
"nivå, utan undernivå."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:187
msgid "Sort accounts alphabetically in a folder tree"
msgstr "Sorter kontoar alfabetisk i eit mappetre"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:188
msgid ""
"Tells how to sort accounts in a folder tree used in a Mail view. When set to "
"true accounts are sorted alphabetically, with an exception of On This "
"Computer and Search folders, otherwise accounts are sorted based on an order "
"given by a user"
msgstr ""
"Avgjer korleis kontoar vert sorterte i mappetreet i e-postvisinga. Når dette "
"er sett til true, vert kontoane sorterte alfabetisk, med unntak av On This "
"Computer og søkjemappene. Elles vert dei sorterte i rekkjefølgja brukaren "
"har valt"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:189
msgid "Log filter actions"
msgstr "Loggfør filterhandlingar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:190
msgid "Log filter actions to the specified log file."
msgstr "Loggfør filterhandlingar til den oppgjevne loggfila."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:191
msgid "Logfile to log filter actions"
msgstr "Loggfil for filterhandlingar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:192
msgid ""
"If not set, or being “stdout”, then the logging is done to stdout, instead "
"to a file."
msgstr ""
"Om dette ikkje er sett, eller er «stdout», vert det logga til stdout i "
"staden for til ei fil."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:193
msgid "Flush Outbox after filtering"
msgstr "Tøm Utboks etter filtrering"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:194
msgid ""
"Whether to flush Outbox after filtering is done. Outbox flush will happen "
"only when there was used any “Forward to” filter action and approximately "
"one minute after the last action invocation."
msgstr ""
"Om Utboks skal tømmast etter filtreringa. Tømminga skjer berre når ei «Send "
"vidare til»-filterhandling har vore brukt, og omtrent eitt minutt etter den "
"siste handlinga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:195
msgid "Default forward style"
msgstr "Standard vidaresendingsstil"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:196
msgid "Default reply style"
msgstr "Standard svarstil"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:197
msgid ""
"Forward and reply attribution language tag, like en_US. Empty string means "
"to use the same language as the user interface."
msgstr ""
"Språkkode for teksten ved vidaresending og svar, til dømes en_US. Tom streng "
"tyder at same språk som brukargrensesnittet vert brukt."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:198
msgid "Prompt on send when using key accelerator (Ctrl+Enter)"
msgstr "Spør ved sending med snarveg (Ctrl+Enter)"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:199
msgid ""
"Prompt the user when he or she tries to send a message with a key "
"accelerator."
msgstr "Spør når brukaren prøver å sende ei melding med ein snarveg."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:200
msgid "Prompt on empty subject"
msgstr "Spør når emnefeltet er tomt"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:201
msgid ""
"Prompt the user when he or she tries to send a message without a Subject."
msgstr "Spør når brukaren prøver å sende ei melding utan emne."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:202
msgid "Prompt when emptying the trash"
msgstr "Spør ved tømming av papirkorga"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:203
msgid "Prompt the user when he or she tries to empty the trash."
msgstr "Spør når brukaren prøver å tømme papirkorga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:204
msgid "Prompt when user expunges"
msgstr "Spør når brukaren tømmer sletta meldingar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:205
msgid "Prompt the user when he or she tries to expunge a folder."
msgstr "Spør når brukaren prøver å tøme ei mappe."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:206
msgid "Prompt when user calls Empty Junk"
msgstr "Spør når brukaren tømmer søppelposten"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:207
msgid "Prompt the user when he or she tries to Empty a Junk folder."
msgstr "Spør når brukaren prøver å tømme ei søppelpostmappe."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:208
msgid "Prompt when user marks message as Junk"
msgstr "Spør når brukaren merkar ei melding som søppelpost"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:209
msgid "Prompt the user when he or she tries to mark a message as Junk."
msgstr "Spør når brukaren prøver å merke ei melding som søppelpost."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:210
msgid "Prompt before sending to recipients not entered as mail addresses"
msgstr ""
"Spør før sending til mottakarar som ikkje er skrivne inn som e-postadresser"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:211
msgid ""
"It disables/enables the repeated prompts to warn that you are trying to send "
"a message to recipients not entered as mail addresses"
msgstr ""
"Slår av eller på dei gjentekne åtvaringane om at du prøver å sende ei "
"melding til mottakarar som ikkje er skrivne inn som e-postadresser"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:212
msgid "Prompt when user only fills Bcc"
msgstr "Spør når brukaren berre fyller ut Bcc"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:213
msgid "Prompt when user tries to send a message with no To or Cc recipients."
msgstr ""
"Spør når brukaren prøver å sende ei melding utan mottakarar i Til eller Cc."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:214
msgid "Prompt when user tries to send unwanted HTML"
msgstr "Spør når brukaren prøver å sende uynskt HTML-e-post"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:215
msgid ""
"Prompt when user tries to send HTML mail to recipients that may not want to "
"receive HTML mail."
msgstr ""
"Spør ved sending av HTML-meldingar til kontaktar som kanskje ikkje vil ha "
"slikt."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:216
msgid "Prompt when user tries to open 10 or more messages at once"
msgstr "Spør når brukaren prøver å opne ti eller fleire meldingar på ein gong"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:217
msgid ""
"If a user tries to open 10 or more messages at one time, ask the user if "
"they really want to do it."
msgstr ""
"Om brukaren prøver å opne 10 eller fleire meldingar på ein gong, spør om det "
"verkeleg er det brukaren vil."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:218
msgid "Prompt while marking multiple messages"
msgstr "Spør når brukaren merkar fleire meldingar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:219
msgid "Enable or disable the prompt whilst marking multiple messages."
msgstr "Slå av eller på spørsmålet når du merkar fleire meldingar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:220
msgid "Prompt when deleting messages in search folder"
msgstr "Spør ved sletting av meldingar i søkjemapper"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:221
msgid ""
"It disables/enables the repeated prompts to warn that deleting messages from "
"a search folder permanently deletes the message, not simply removing it from "
"the search results."
msgstr ""
"Slår av eller på dei gjentekne åtvaringane om at sletting av meldingar frå "
"ei søkjemappe slettar meldinga for godt, ikkje berre fjernar ho frå "
"søkjeresultatet."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:222
msgid "Asks whether to copy a folder by drag-and-drop in the folder tree"
msgstr "Spør om ei mappe skal kopierast ved dra-og-slepp i mappetreet"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:223
msgid ""
"Possible values are: “never” — do not allow copy with drag-and-drop of "
"folders in folder tree, “always” — allow copy with drag-and-drop of folders "
"in folder tree without asking, or “ask” — (or any other value) will ask user."
msgstr ""
"Moglege verdiar er: «never» — ikkje tillat kopiering av mapper med dra-og-"
"slepp i mappetreet, «always» — tillat kopiering med dra-og-slepp utan å "
"spørje, eller «ask» — (eller ein annan verdi) spør brukaren."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:224
msgid "Asks whether to move a folder by drag-and-drop in the folder tree"
msgstr "Spør om ei mappe skal flyttast ved dra-og-slepp i mappetreet"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:225
msgid ""
"Possible values are: “never” — do not allow move with drag-and-drop of "
"folders in folder tree, “always” — allow move with drag-and-drop of folders "
"in folder tree without asking, or “ask” — (or any other value) will ask user."
msgstr ""
"Moglege verdiar er: «never» — ikkje tillat flytting av mapper med dra-og-"
"slepp i mappetreet, «always» — tillat flytting med dra-og-slepp utan å "
"spørje, eller «ask» — (eller ein annan verdi) spør brukaren."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:226
msgid "Prompt when replying privately to list messages"
msgstr "Spør når du svarar privat på meldingar frå lister"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:227
msgid ""
"It disables/enables the repeated prompts to warn that you are sending a "
"private reply to a message which arrived via a mailing list."
msgstr ""
"Slår av eller på dei gjentekne åtvaringane om at du sender eit privat svar "
"på ei melding som kom via ei e-postliste."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:228
msgid "Prompt when mailing list hijacks private replies"
msgstr "Spør når ei e-postliste kaprar private svar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:229
msgid ""
"It disables/enables the repeated prompts to warn that you are trying sending "
"a private reply to a message which arrived via a mailing list, but the list "
"sets a Reply-To: header which redirects your reply back to the list"
msgstr ""
"Slår av eller på dei gjentekne åtvaringane om at du prøver å sende eit "
"privat svar på ei melding som kom via ei e-postliste, men lista set eit "
"Reply-To:-hovud som sender svaret tilbake til lista"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:230
msgid "Prompt when replying to many recipients"
msgstr "Spør når du svarar til mange mottakarar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:231
msgid ""
"It disables/enables the repeated prompts to warn that you are sending a "
"reply to many people."
msgstr ""
"Slår av eller på dei gjentekne åtvaringane om at du sender eit svar til "
"mange personar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:232
msgid ""
"Prompt when switching composer format and the content needs to lose its "
"formatting"
msgstr ""
"Spør når du byter format i meldingsredigeringa og innhaldet må miste "
"formateringa"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:233
msgid ""
"It disables/enables the repeated prompts to warn that you are switching "
"composer format and the content needs to lose its formatting."
msgstr ""
"Slår av eller på dei gjentekne åtvaringane om at du byter format i "
"meldingsredigeringa og at innhaldet må miste formateringa."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:234
msgid "Prompt when sending to many To and CC recipients"
msgstr "Spør ved sending til mange Til- og Cc-mottakarar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:235
msgid ""
"Enable or disable the prompt when sending to many To and CC recipients. The "
"“composer-many-to-cc-recips-num” defines the threshold."
msgstr ""
"Slå av eller på spørsmålet ved sending til mange Til- og Cc-mottakarar. "
"«composer-many-to-cc-recips-num» avgjer grensa."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:236
msgid "List of addresses, or even parts of addresses, which accept HTML"
msgstr "Liste over adresser, eller delar av adresser, som tek imot HTML"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:237
msgid ""
"It's a complementary option for “prompt-on-unwanted-html”, containing list "
"of addresses, which accept HTML messages."
msgstr ""
"Eit tilleggsval til «prompt-on-unwanted-html» med ei liste over adresser som "
"tek imot HTML-meldingar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:238
msgid ""
"Policy for automatically closing the message browser window when forwarding "
"or replying to the displayed message."
msgstr ""
"Reglar for når meldingsvindauget skal lukkast automatisk ved vidaresending "
"av eller svar på den viste meldinga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:239
msgid "Empty Trash folders on exit"
msgstr "Tøm papirkorgmapper ved avslutting"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:240
msgid "Empty all Trash folders when exiting Evolution."
msgstr "Tøm alle papirkorgmapper når Evolution vert avslutta."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:241
msgid "Minimum days between emptying the trash on exit"
msgstr "Minste tal på dagar mellom kvar tømming av papirkorga ved avslutting"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:242
msgid "Minimum time between emptying the trash on exit, in days."
msgstr "Minste tid mellom kvar tømming av papirkorga ved avslutting, i dagar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:243
msgid "Last time Empty Trash was run"
msgstr "Sist papirkorga vart tømd"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:244
msgid ""
"The last time Empty Trash was run, in days since January 1st, 1970 (Epoch)."
msgstr "Sist papirkorga vart tømd, i dagar sidan 1. januar 1970 (Epoch)."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:245
msgid "Amount of time in seconds the error should be shown on the status bar."
msgstr "Kor mange sekund feilen skal visast på statuslinja."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:246
msgid "Level beyond which the message should be logged."
msgstr "Meldingar over dette nivået skal loggførast."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:247
msgid ""
"This can have three possible values. “0” for errors. “1” for warnings. “2” "
"for debug messages."
msgstr ""
"Denne kan ha tre verdiar: «0» for feil, «1» for åtvaringar og «2» for "
"feilsøkingsmeldingar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:248
msgid "Show original “Date” header value."
msgstr "Vis den opphavlege verdien i «Date»-hovudet."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:249
msgid ""
"Show the original “Date” header with a user preferred format and in the "
"local time zone value beside it."
msgstr ""
"Vis den opphavlege verdien i «Date»-hovudet, med verdien i føretrekt format "
"og lokal tidssone ved sida av."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:250
msgid "List of Labels and their associated colors"
msgstr "Liste over merkelappar og fargane deira"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:251
msgid ""
"List of labels known to the mail component of Evolution. The list contains "
"strings containing name:color where color uses the HTML hex encoding."
msgstr ""
"Liste over merkelappar e-post-delen av Evolution veit om. Lista inneheld "
"strengar som inneheld «name:color» der fargen brukar HTML hex-koding."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:252
msgid "Check incoming mail being junk"
msgstr "Kontroller om ny e-post er søppelpost"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:253
msgid "Run junk test on incoming mail."
msgstr "Kontroller om ny e-post er søppelpost."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:254
msgid "Empty Junk folders on exit"
msgstr "Tøm søppelpostmapper ved avslutting"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:255
msgid "Empty all Junk folders when exiting Evolution."
msgstr "Tøm alle søppelpostmapper når Evolution vert avslutta."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:256
msgid "Minimum days between emptying the junk on exit"
msgstr "Minste tal på dagar mellom kvar tømming av søppelposten ved avslutting"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:257
msgid "Minimum time between emptying the junk on exit, in days."
msgstr ""
"Minste tid mellom kvar tømming av søppelposten ved avslutting, i dagar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:258
msgid "Last time Empty Junk was run"
msgstr "Sist søppelposten vart tømd"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:259
msgid ""
"The last time Empty Junk was run, in days since January 1st, 1970 (Epoch)."
msgstr "Sist søppelposten vart tømd, i dagar sidan 1. januar 1970 (Epoch)."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:260
msgid "The default plugin for Junk hook"
msgstr "Standardtillegget for søppelpostkroken"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:261
msgid ""
"This is the default junk plugin, even though there are multiple plugins "
"enabled. If the default listed plugin is disabled, then it won’t fall back "
"to the other available plugins."
msgstr ""
"Dette er standardtillegget for søppelpost, sjølv om fleire tillegg er slått "
"på. Er standardtillegget slått av, vert det ikkje brukt andre tilgjengelege "
"tillegg i staden."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:262
msgid "Determines whether to lookup in address book for sender email"
msgstr "Avgjer om avsendaradressa skal slåast opp i adresseboka"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:263
msgid ""
"Determines whether to lookup the sender email in address book. If found, it "
"shouldn’t be a spam. It looks up in the books marked for autocompletion. It "
"can be slow, if remote address books (like LDAP) are marked for "
"autocompletion."
msgstr ""
"Avgjer om avsendaradressa skal slåast opp i adresseboka. Om ho vert funnen, "
"er meldinga ikkje søppelpost. Oppslaget skjer i adressebøker som er merkte "
"for autofullføring. Det kan gå seint om eksterne adressebøker (som LDAP) er "
"merkte for autofullføring."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:264
msgid ""
"Determines whether to look up addresses for junk filtering in local address "
"book only"
msgstr ""
"Avgjer om adresser for søppelpostfiltrering berre skal slåast opp i lokale "
"adressebøker"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:265
msgid ""
"This option is related to the key lookup_addressbook and is used to "
"determine whether to look up addresses in local address book only to exclude "
"mail sent by known contacts from junk filtering."
msgstr ""
"Dette valet høyrer til nøkkelen lookup_addressbook og avgjer om adresser "
"berre skal slåast opp i lokale adressebøker, slik at e-post frå kjende "
"kontaktar ikkje vert søppelpostfiltrert."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:266
msgid "Determines whether to use custom headers to check for junk"
msgstr "Avgjer om eigne meldingshovud skal brukast til å sjå etter søppelpost"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:267
msgid ""
"Determines whether to use custom headers to check for junk. If this option "
"is enabled and the headers are mentioned, it will be improve the junk "
"checking speed."
msgstr ""
"Avgjer om eigne meldingshovud skal brukast til å sjå etter søppelpost. Er "
"valet slått på og hovuda er oppgjevne, går søppelpostkontrollen raskare."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:268
msgid "Custom headers to use while checking for junk."
msgstr "Eigne meldingshovud som skal brukast ved søppelpostkontroll."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:269
msgid ""
"Custom headers to use while checking for junk. The list elements are string "
"in the format “headername=value”."
msgstr ""
"Eigne meldingshovud som skal brukast ved søppelpostkontroll. Elementa i "
"lista er strengar på forma «headername=value»."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:270
msgid "UID string of the default account."
msgstr "UID-streng til standardkontoen."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:271
msgid "Save directory"
msgstr "Lagringsmappe"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:272
msgid "Directory for saving mail component files."
msgstr "Mappe for lagring av filer frå e-postdelen."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:273
msgid "Save format"
msgstr "Lagringsformat"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:274
msgid "Last used format when saving messages to file."
msgstr "Sist brukte format ved lagring av meldingar til fil."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:275
msgid "Composer load/attach directory"
msgstr "Mappe for lasting og vedlegg i meldingsredigeringa"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:276
msgid "Directory for loading/attaching files to composer."
msgstr "Mappe for lasting av filer og vedlegg i meldingsredigeringa."

# TRN: Kva betyr dette?
#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:277
msgid "Check for new messages on start"
msgstr "Sjå etter nye meldingar ved oppstart"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:278
msgid ""
"Whether to check for new messages when Evolution is started. This includes "
"also sending messages from Outbox."
msgstr ""
"Om det skal sjåast etter nye meldingar når Evolution startar. Dette omfattar "
"òg sending av meldingar frå Utboks."

# TRN: Kva betyr dette?
#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:279
msgid "Check for new messages in all active accounts"
msgstr "Sjå etter nye meldingar i alle aktive kontoar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:280
msgid ""
"Whether to check for new messages in all active accounts regardless of the "
"account “Check for new messages every X minutes” option when Evolution is "
"started. This option is used only together with “send_recv_on_start” option."
msgstr ""
"Om det skal sjåast etter nye meldingar i alle aktive kontoar når Evolution "
"startar, uavhengig av valet «Sjå etter nye meldingar kvart X minutt» for "
"kontoen. Dette valet vert berre brukt saman med «send_recv_on_start»."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:281
msgid "Server synchronization interval"
msgstr "Intervall for synkronisering med tenaren"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:282
msgid ""
"Controls how frequently local changes are synchronized with the remote mail "
"server. The interval must be at least 30 seconds."
msgstr ""
"Styrer kor ofte lokale endringar vert synkroniserte med e-posttenaren. "
"Intervallet må vere minst 30 sekund."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:283
msgid "Allow expunge in virtual folders"
msgstr "Tillat tømming i virtuelle mapper"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:284
msgid ""
"Enables Expunge in virtual folders, which means that the Folder→Expunge will "
"be callable in virtual folders, while the expunge itself will be done in all "
"folders for all deleted messages within the virtual folder, not only for "
"deleted messages belonging to the virtual folder."
msgstr ""
"Gjer det mogleg å tømme virtuelle mapper, det vil seie at Mappe→Tøm kan "
"brukast i virtuelle mapper. Sjølve tømminga vert gjort i alle mapper for "
"alle sletta meldingar i den virtuelle mappa, ikkje berre for sletta "
"meldingar som høyrer til den virtuelle mappa."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:285
#: ../src/mail/mail-config.ui.h:10
msgid "Inherit theme colors in HTML format"
msgstr "Arv temafargar i HTML-format"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:286
msgid ""
"When enabled the theme colors for background, text and links are sent in "
"resulting HTML formatted message."
msgstr ""
"Når dette er slått på, vert temafargane for bakgrunn, tekst og lenkjer sende "
"med i den ferdige HTML-meldinga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:287
msgid "Use theme colors in HTML composer"
msgstr "Bruk temafargar i HTML-redigeringa"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:288
msgid ""
"When enabled the theme colors are used for the composer background and text "
"while editing, but they are not included in the sent message. This option "
"has no effect when “Inherit theme colors” is enabled."
msgstr ""
"Når dette er slått på, vert temafargane brukte til bakgrunnen og teksten "
"medan du redigerer, men dei vert ikkje tekne med i den sende meldinga. Valet "
"har ingen verknad når «Arv temafargar» er slått på."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:289
msgid "An Archive folder for On This Computer folders."
msgstr "Ei arkivmappe for mapper på «På denne datamaskina»."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:290
msgid ""
"An Archive folder to use for Messages|Archive... feature when in an On This "
"Computer folder."
msgstr ""
"Ei arkivmappe for funksjonen Meldingar|Arkiver... i ei mappe på «På denne "
"datamaskina»."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:291
msgid "Whether the To Do bar is visible in the main window"
msgstr "Om gjeremålslinja er synleg i hovudvindauget"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:292
msgid "Stores whether the To Do bar is visible in the main window."
msgstr "Lagrar om gjeremålslinja er synleg i hovudvindauget."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:293
msgid "Width of the To Do bar in the main window"
msgstr "Breidda på gjeremålslinja i hovudvindauget"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:294
msgid "Holds the width of the To Do bar for the main window."
msgstr "Lagrar breidda på gjeremålslinja i hovudvindauget."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:295
msgid "Whether the To Do bar is visible in a sub-window"
msgstr "Om gjeremålslinja er synleg i eit undervindauge"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:296
msgid "Stores whether the To Do bar is visible in a sub-window."
msgstr "Lagrar om gjeremålslinja er synleg i eit undervindauge."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:297
msgid "Width of the To Do bar in a sub-window"
msgstr "Breidda på gjeremålslinja i eit undervindauge"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:298
msgid "Holds the width of the To Do bar for a sub-window."
msgstr "Lagrar breidda på gjeremålslinja i eit undervindauge."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:299
msgid "Whether the To Do bar should show also completed tasks"
msgstr "Om gjeremålslinja òg skal vise fullførte oppgåver"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:300
msgid "Stores whether the To Do bar should show also completed tasks."
msgstr "Lagrar om gjeremålslinja òg skal vise fullførte oppgåver."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:301
msgid "Whether the To Do bar should show also tasks without Due date"
msgstr "Om gjeremålslinja òg skal vise oppgåver utan frist"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:302
msgid "Stores whether the To Do bar should show also tasks without Due date."
msgstr "Lagrar om gjeremålslinja òg skal vise oppgåver utan frist."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:303
msgid "How many days to show in the To Do bar"
msgstr "Kor mange dagar som skal visast i gjeremålslinja"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:304
msgid "Values out of range are clamped to the boundary."
msgstr "Verdiar utanfor området vert avgrensa til grensa."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:305
msgid "Use smaller font for time in the To Do bar"
msgstr "Bruk mindre skrift for klokkeslett i gjeremålslinja"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:306
msgid "Show start up wizard"
msgstr "Vis oppstartsvegvisaren"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:307
msgid "Whether show start up wizard when there is no mail account configured."
msgstr "Om oppstartsvegvisaren skal visast når ingen e-postkonto er sett opp."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:308
msgid "Whether go to the previous message after message deletion"
msgstr "Om førre melding skal veljast etter sletting"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:309
msgid ""
"If set to true, goes to the previous message when the selected is deleted; "
"or to the next message, when it’s set to false."
msgstr ""
"Om dette er sett til true, vert førre melding vald når den valde meldinga "
"vert sletta; om det er sett til false, vert neste melding vald."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:310
msgid "Show Subject above Sender in Messages column"
msgstr "Vis Emne over Avsendar i Meldingar-kolonnen"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:311
msgid ""
"Whether to show Subject above Sender (From/To) in the Messages column, "
"usually shown in the Vertical/Wide view of the message list. Change of this "
"option requires restart of the Evolution."
msgstr ""
"Om emnet skal visast over avsendaren (Frå/Til) i kolonnen Meldingar, som "
"vanlegvis vert vist i loddrett/brei vising av meldingslista. Endring av "
"valet krev omstart av Evolution."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:312
msgid "Visually wrap long lines in composer"
msgstr "Bryt lange linjer visuelt i meldingsredigeringa"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:313
#: ../src/composer/e-composer-actions.c:650
msgid ""
"Whether to visually wrap long lines of text to avoid horizontal scrolling"
msgstr ""
"Om lange tekstlinjer skal brytast visuelt for å unngå horisontal rulling"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:314
msgid "Alternative reply style"
msgstr "Alternativt svarformat"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:315
msgid "Composer mode to use."
msgstr "Modus i meldingsredigeringa som skal brukast."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:316
msgid "Put the cursor at the bottom of alternative replies"
msgstr "Set markøren nedst i alternative svar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:317
msgid ""
"This determines whether the cursor is placed at the top of the message or "
"the bottom when using Alternative Reply."
msgstr ""
"Dette avgjer om markøren vert plassert øvst eller nedst i meldinga når du "
"brukar alternativt svar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:318
msgid "Put the signature at the top of the message"
msgstr "Set signaturen øvst i meldinga"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:319
msgid ""
"This determines whether the signature is placed at the top of the message or "
"the bottom when using Alternative Reply."
msgstr ""
"Dette avgjer om signaturen skal plasserast øvst eller nedst i meldinga når "
"du brukar Alternativt svar."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:320
msgid "Apply chosen template when using Alternative Reply"
msgstr "Bruk valt mal når du brukar Alternativt svar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:321
msgid "Last chosen template’s folder URI for Alternative Reply"
msgstr "URI til mappa for den sist valde malen for alternativt svar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:322
msgid "Last chosen template’s message UID for Alternative Reply"
msgstr "Meldings-UID-en til den sist valde malen for alternativt svar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:323
msgid ""
"Whether preserve original message subject when applying template for "
"Alternative Reply"
msgstr ""
"Om det opphavlege emnet skal behaldast når ein mal vert brukt for "
"alternativt svar"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:324
msgid ""
"Whether set “body” in mailto: URI as Preformatted paragraph style. If set to "
"“false”, then Normal paragraph style will be used."
msgstr ""
"Om «body» i mailto:-URI-ar skal brukast som førehandsformatert avsnittsstil. "
"Om «false», vert vanleg avsnittsstil brukt."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:325
msgid ""
"Close the message browser window when the selected message is deleted or "
"marked as Junk."
msgstr ""
"Lukk meldingsvindauget når den valde meldinga vert sletta eller merkt som "
"søppelpost."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:326
msgid ""
"Collapse archive folders in Move/Copy message to Folder and Go to Folder "
"selectors."
msgstr ""
"Fald saman arkivmapper i veljarane for Flytt/kopier melding til mappe og Gå "
"til mappe."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:327
msgid ""
"Where to lookup recipient S/MIME certificates or PGP keys when encrypting "
"messages."
msgstr ""
"Kvar S/MIME-sertifikat eller PGP-nøklar for mottakarar skal slåast opp når "
"meldingar vert krypterte."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:328
msgid ""
"The “off” value completely disables certificate lookup; the “autocompleted” "
"value provides certificates only for auto-completed contacts; the “books” "
"value uses certificates from auto-completed contacts and searches in books "
"marked for auto-completion."
msgstr ""
"Verdien «off» slår av sertifikatoppslag heilt; verdien «autocompleted» gjev "
"berre sertifikat for autofullførte kontaktar; verdien «books» brukar "
"sertifikat frå autofullførte kontaktar og søkjer i adressebøker som er "
"merkte for autofullføring."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:329
msgid "Whether Send/Receive should also download of messages for offline."
msgstr "Om Send/ta imot òg skal laste ned meldingar for fråkopla bruk."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:330
msgid ""
"If enabled, whenever Send/Receive is run it also runs synchronization of "
"messages for offline use. The option is disabled by default."
msgstr ""
"Om dette er slått på, vert meldingar òg synkroniserte for fråkopla bruk kvar "
"gong Send/ta imot vert køyrt. Valet er slått av som standard."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:331
msgid "Whether display delivery notification parts inline."
msgstr "Om delar med leveringsvarsel skal visast innebygde."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:332
msgid ""
"If enabled, the message/delivery-status and message/disposition-notification "
"parts are shown automatically inline."
msgstr ""
"Om dette er slått på, vert delane message/delivery-status og message/"
"disposition-notification viste innebygde automatisk."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:333
msgid "Whether unset colors provided in HTML mails."
msgstr "Om fargar frå HTML-e-post skal fjernast."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:334
msgid ""
"If enabled, unset colors in HTML messages, forcing use of desktop theme "
"colors instead."
msgstr ""
"Om dette er slått på, vert fargane i HTML-meldingar fjerna, slik at fargane "
"frå skrivebordstemaet vert brukte i staden."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:335
msgid ""
"Whether to preserve expand state of the folders when calling Copy/Move to "
"Folder."
msgstr ""
"Om utfaldinga av mapper skal behaldast når Kopier/flytt til mappe vert brukt."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:336
msgid ""
"If enabled, the Copy/Move to Folder dialog will preserve the expand state of "
"the folders in the dialog, otherwise all the folders will be expanded."
msgstr ""
"Om dette er slått på, behaldar vindauget Kopier/flytt til mappe utfaldinga "
"av mappene, elles vert alle mappene falda ut."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:337
msgid "Whether to print attachments."
msgstr "Om vedlegg skal skrivast ut."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:338
msgid ""
"If enabled, and possible, attachment content is printed with the message."
msgstr ""
"Om dette er slått på og mogleg, vert innhaldet i vedlegga skrive ut saman "
"med meldinga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:339
msgid "Size limit for text attachments to show"
msgstr "Storleiksgrense for tekstvedlegg som skal visast"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:340
msgid ""
"Defines the size in KB, the limit to show text attachments in the message "
"preview. Anything above this limit will not be possible to show inline."
msgstr ""
"Grensa i KB for vising av tekstvedlegg i førehandsvisinga av meldingar. "
"Vedlegg over denne grensa kan ikkje visast innebygde."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:341
msgid "Show Preview Toolbar"
msgstr "Vis verktøylinja for førehandsvising"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:342
msgid "Show toolbar above preview panel in the Mail view."
msgstr "Vis verktøylinja over førehandsvisingspanelet i e-postvisinga."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:343
msgid ""
"Whether the markdown composer should sanitize input text also for the "
"'Markdown as Plain text' mode"
msgstr ""
"Om markdown-redigeringa òg skal reinske inndatateksten i modusen 'Markdown "
"som rein tekst'"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:344
msgid ""
"Disabling the sanitization allows to use the Markdown editor as a very "
"simple text editor without mangling the input text."
msgstr ""
"Slår du av reinskinga, kan Markdown-redigeringa brukast som ein svært enkel "
"tekstredigerar utan at teksten vert endra."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:345
msgid "Show unread count in folder tree"
msgstr "Vis tal på ulesne i mappetreet"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:346
msgid "Show unread count beside the folder name in the folder tree."
msgstr "Vis talet på ulesne meldingar ved sida av mappenamnet i mappetreet."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:347
msgid "Show insecure parts by default"
msgstr "Vis usikre delar som standard"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:348
msgid ""
"Set whether not signed/encrypted parts beside signed/encrypted parts should "
"be shown after mail open. The default is to hide these possibly insecure "
"parts."
msgstr ""
"Avgjer om delar som ikkje er signerte/krypterte, skal visast ved sida av "
"signerte/krypterte delar når e-posten vert opna. Som standard er desse "
"moglege usikre delane gøymde."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:349
msgid "How to convert links from HTML to plain text"
msgstr "Korleis lenkjer skal konverterast frå HTML til rein tekst"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:350
msgid ""
"Possible values: 'none' - do not store href in the plain text; 'inline' - "
"show href beside the text link, like: \"label &lt;href&gt;\"; 'reference' - "
"show href as reference to the end of the text, like: \"label [1] ...... [1] "
"label href\"; 'reference-without-label' - show href as reference to the end "
"of the text without label, like: \"label [1] ...... [1] href\""
msgstr ""
"Moglege verdiar: 'none' - ikkje lagre href i den reine teksten; 'inline' - "
"vis href ved sida av lenkjeteksten, slik: \"label &lt;href&gt;\"; "
"'reference' - vis href som referanse på slutten av teksten, slik: \"label "
"[1] ...... [1] label href\"; 'reference-without-label' - vis href som "
"referanse på slutten av teksten utan etikett, slik: \"label [1] ...... [1] "
"href\""

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:351
msgid ""
"Whether click on a header in the message list can change sort order by the "
"clicked column."
msgstr ""
"Om eit klikk på ein kolonnetittel i meldingslista kan endre sorteringa etter "
"kolonnen du klikka på."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:352
msgid "Attach multiple messages as separate files"
msgstr "Legg ved fleire meldingar som separate filer"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:353
msgid ""
"When attaching multiple messages at once, attach them as separate files "
"(when set to 'true'), instead of a single mbox file."
msgstr ""
"Når fleire meldingar vert lagde ved samtidig, vert dei lagde ved som "
"separate filer (når dette er sett til 'true') i staden for som éi mbox-fil."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:354
msgid "Set folder text color when it received a new message"
msgstr "Set tekstfarge på mappa når ho får ei ny melding"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:355
msgid ""
"Some `@theme_` colors are supported, otherwise a color name like `orange` or "
"color reference like `#07509c` or `rgb(215,150,0)` can be used. Not setting "
"a color, or using an invalid form, will not change the folder name text "
"color. A value 'auto' will pick a suitable blue color for the current color "
"theme."
msgstr ""
"Nokre `@theme_`-fargar er støtta, elles kan eit fargenamn som `orange` eller "
"ein fargereferanse som `#07509c` eller `rgb(215,150,0)` brukast. Utan farge, "
"eller med ei ugyldig form, vert ikkje tekstfargen på mappenamnet endra. "
"Verdien 'auto' vel ein passande blåfarge for det gjeldande fargetemaet."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:356
msgid "(Deprecated) Default forward style"
msgstr "(Utdatert) Standard vidaresendingsstil"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:357
msgid ""
"This key was deprecated in version 3.10 and should no longer be used. Use "
"“forward-style-name” instead."
msgstr ""
"Denne nøkkelen vart forelda i versjon 3.10 og skal ikkje brukast lenger. "
"Bruk «forward-style-name» i staden."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:358
msgid "(Deprecated) Default reply style"
msgstr "(Utdatert) Standard svarstil"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:359
msgid ""
"This key was deprecated in version 3.10 and should no longer be used. Use "
"“reply-style-name” instead."
msgstr ""
"Denne nøkkelen vart forelda i versjon 3.10 og skal ikkje brukast lenger. "
"Bruk «reply-style-name» i staden."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:360
msgid "(Deprecated) List of custom headers and whether they are enabled."
msgstr "(Utdatert) Liste over eigne meldingshovud og om dei er slått på."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:361
msgid ""
"This key was deprecated in version 3.10 and should no longer be used. Use "
"“show-headers” instead."
msgstr ""
"Denne nøkkelen vart forelda i versjon 3.10 og skal ikkje brukast lenger. "
"Bruk «show-headers» i staden."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:362
msgid "(Deprecated) Load images for HTML messages over HTTP"
msgstr "(Utdatert) Last bilete i HTML-meldingar over HTTP"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:363
msgid ""
"This key was deprecated in version 3.10 and should no longer be used. Use "
"“image-loading-policy” instead."
msgstr ""
"Denne nøkkelen vart forelda i versjon 3.10 og skal ikkje brukast lenger. "
"Bruk «image-loading-policy» i staden."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:364
msgid ""
"(Deprecated) Asks whether to close the message window when the user forwards "
"or replies to the message shown in the window"
msgstr ""
"(Utdatert) Spør om meldingsvindauget skal lukkast når brukaren vidaresender "
"eller svarar på meldinga som er vist i vindauget"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:365
msgid ""
"This key was deprecated in version 3.10 and should no longer be used. Use "
"“browser-close-on-reply-policy” instead."
msgstr ""
"Denne nøkkelen vart forelda i versjon 3.10 og skal ikkje brukast lenger. "
"Bruk «browser-close-on-reply-policy» i staden."

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:366
msgid "Prompt before send when attachment changed on the disk"
msgstr "Spør før sending når eit vedlegg er endra på disken"

#: ../data/org.gnome.evolution.mail.gschema.xml.in.h:367
msgid ""
"Ask whether can send a message with attachments which changed on the disk "
"since they had been attached to the message."
msgstr ""
"Spør om ei melding kan sendast med vedlegg som er endra på disken sidan dei "
"vart lagde ved meldinga."

#. Translators: This is a list of words for the attach reminder plugin to look
#. for in a message body. Please use any number of words here in your language that might
#. indicate that an attachment should have been attached to the message.
#: ../data/org.gnome.evolution.plugin.attachment-reminder.gschema.xml.in.h:4
msgid "['attachment','attaching','attached','enclosed']"
msgstr "['vedlegg','legg ved','vedlagt','lagt ved']"

#: ../data/org.gnome.evolution.plugin.attachment-reminder.gschema.xml.in.h:5
msgid ""
"List of clues for the attachment reminder plugin to look for in a message "
"body"
msgstr ""
"Liste over stikkord som vedleggspåminnaren skal sjå etter i meldingskroppen"

#: ../data/org.gnome.evolution.plugin.attachment-reminder.gschema.xml.in.h:6
msgid ""
"List of clues for the attachment reminder plugin to look for in a message "
"body."
msgstr ""
"Liste over stikkord som vedleggspåminnaren skal sjå etter i meldingskroppen."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:1
msgid "Address book source"
msgstr "Kjelde for adressebok"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:2
msgid "Address book to use for storing automatically synced contacts."
msgstr "Adressebok for lagring av automatisk synkroniserte kontaktar."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:3
msgid "Auto sync Pidgin contacts"
msgstr "Synkroniser Pidgin-kontaktar automatisk"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:4
msgid "Whether Pidgin contacts should be automatically synced."
msgstr "Om Pidgin-kontaktar skal synkroniserast automatisk."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:5
msgid "Enable autocontacts"
msgstr "Slå på autokontaktar"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:6
msgid ""
"Whether contacts should be automatically added to the user’s address book."
msgstr "Om kontaktar automatisk skal leggjast til i brukaren si adressebok."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:7
msgid "Whether to set “File under” field as “First Last”"
msgstr "Om feltet «Arkiver under» skal setjast til «Førenamn Etternamn»"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:8
msgid "Set File under as “First Last”, instead of “Last, First”."
msgstr ""
"Set Arkiver under til «Førenamn Etternamn» i staden for «Etternamn, "
"Førenamn»."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:9
msgid "Pidgin address book source"
msgstr "Adressebokkjelde for Pidgin"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:10
msgid ""
"Address book to use for storing automatically synced contacts from Pidgin."
msgstr ""
"Adressebok som skal brukast til å lagre automatisk synkroniserte kontaktar "
"frå Pidgin."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:11
msgid "Pidgin check interval"
msgstr "Intervall for Pidgin-sjekk"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:12
msgid "Check interval for Pidgin syncing of contacts."
msgstr "Intervall for sjekk av Pidgin-synkronisering av kontaktar."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:13
msgid "Pidgin last sync MD5"
msgstr "MD5 for siste Pidgin-synkronisering"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:14
msgid "Pidgin last sync MD5."
msgstr "MD5 for siste Pidgin-synkronisering."

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:15
msgid "Pidgin last sync time"
msgstr "Tidspunkt for siste Pidgin-synkronisering"

#: ../data/org.gnome.evolution.plugin.autocontacts.gschema.xml.in.h:16
msgid "Pidgin last sync time."
msgstr "Tidspunkt for siste Pidgin-synkronisering."

#: ../data/org.gnome.evolution.plugin.email-custom-header.gschema.xml.in.h:1
msgid "List of Custom Headers"
msgstr "Liste over eigne meldingshovud"

#: ../data/org.gnome.evolution.plugin.email-custom-header.gschema.xml.in.h:2
msgid ""
"The key specifies the list of custom headers that you can add to an outgoing "
"message. The format for specifying a Header and Header value is: Name of the "
"custom header followed by “=” and the values separated by “;”"
msgstr ""
"Nøkkelen inneheld lista over eigne meldingshovud du kan leggje til i ei "
"utgåande melding. Eit hovud og verdiane vert oppgjevne slik: namnet på "
"hovudet, så «=», og verdiane skilde med «;»"

#: ../data/org.gnome.evolution.plugin.external-editor.gschema.xml.in.h:1
msgid "Default External Editor"
msgstr "Standard eksternt redigeringsprogram"

#: ../data/org.gnome.evolution.plugin.external-editor.gschema.xml.in.h:2
msgid "The default command that must be used as the editor."
msgstr "Standardkommandoen som skal brukast som redigeringsprogram."

#: ../data/org.gnome.evolution.plugin.external-editor.gschema.xml.in.h:3
msgid "Automatically launch when a new mail is edited"
msgstr "Start automatisk når ein ny e-post vert redigert"

#: ../data/org.gnome.evolution.plugin.external-editor.gschema.xml.in.h:4
msgid "Automatically launch editor when key is pressed in the mail composer."
msgstr ""
"Start redigeringsprogrammet automatisk når ein tast vert trykt i "
"meldingsredigeringa."

#: ../data/org.gnome.evolution.plugin.face-picture.gschema.xml.in.h:1
msgid "Insert Face picture by default"
msgstr "Set inn Face-bilete som standard"

#: ../data/org.gnome.evolution.plugin.face-picture.gschema.xml.in.h:2
msgid ""
"Whether insert Face picture to outgoing messages by default. The picture "
"should be set before checking this, otherwise nothing happens."
msgstr ""
"Om Face-biletet skal setjast inn i utgåande meldingar som standard. Biletet "
"må setjast før dette vert aktivert, elles skjer det ingenting."

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:1
msgid "Delete processed"
msgstr "Slett handsama"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:2
msgid "Whether to delete processed iTip objects"
msgstr "Om handsama iTip-objekt skal slettast"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:3
msgid "Preserve existing reminder by default"
msgstr "Behald eksisterande påminning som standard"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:4
msgid "Whether to preset option to preserve existing reminder by default"
msgstr "Om valet om å behalde eksisterande påminning skal vere førehandsvalt"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:5
msgid "Show invitation description provided by the sender"
msgstr "Vis invitasjonsskildringa frå avsendaren"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:6
msgid ""
"Set to true to show invitation description as provided by the sender, if "
"such is available"
msgstr ""
"Set til true for å vise invitasjonsskildringa slik avsendaren har skrive ho, "
"om ho finst"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:7
msgid "Whether to attach components in mail messages"
msgstr "Om komponentar skal leggjast ved i e-postmeldingar"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:8
msgid ""
"Attach components in mail messages like meeting invitations or responses, "
"instead of saving them as a body alternative"
msgstr ""
"Legg ved komponentar som møteinvitasjonar eller svar i e-postmeldingar i "
"staden for å lagre dei som eit alternativ til meldingskroppen"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:9
msgid "Show a day agenda for the start time of the invitation"
msgstr "Vis ein dagsagenda for starttidspunktet til invitasjonen"

#: ../data/org.gnome.evolution.plugin.itip.gschema.xml.in.h:10
msgid ""
"Show a day agenda, events for the day, when the event in the invitation mail "
"starts"
msgstr ""
"Vis dagsagendaen, med hendingane den dagen, når hendinga i invitasjonen "
"byrjar"

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:1
msgid "Notify new messages for Inbox only."
msgstr "Varsle om nye meldingar berre i Innboks."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:2
msgid "Whether to notify new messages in Inbox folder only."
msgstr "Om det berre skal varslast om nye meldingar i Innboks-mappa."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:3
msgid "Enable D-Bus messages."
msgstr "Slå på D-Bus-meldingar."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:4
msgid "Generates a D-Bus message when new mail messages arrive."
msgstr "Lagar ei D-Bus-melding når nye e-postar kjem."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:5
msgid "Enable icon in notification area."
msgstr "Slå på ikon i varslingsområdet."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:6
msgid "Show new mail icon in notification area when new messages arrive."
msgstr "Vis nytt e-postikon i varslingsområdet når nye meldingar kjem."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:7
msgid "Popup message together with the icon."
msgstr "Sprettoppmelding saman med ikonet."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:8
msgid "Whether show message over the icon when new messages arrive."
msgstr "Om ei melding skal visast over ikonet når nye meldingar kjem."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:9
msgid "Enable audible notifications when new messages arrive."
msgstr "Slå på lydvarsel når nye meldingar kjem."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:10
msgid ""
"Whether to make a sound of any kind when new messages arrive. If “false”, "
"the “notify-sound-beep”, “notify-sound-file”, “notify-sound-play-file” and "
"“notify-sound-use-theme” keys are disregarded."
msgstr ""
"Om det skal spelast av ein lyd når nye meldingar kjem. Om «false», vert "
"nøklane «notify-sound-beep», «notify-sound-file», «notify-sound-play-file» "
"og «notify-sound-use-theme» oversette."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:11
msgid "Whether to emit a beep."
msgstr "Om det skal pipast."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:12
msgid "Whether to emit a beep when new messages arrive."
msgstr "Om det skal pipast når nye meldingar kjem."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:13
msgid "Sound filename to be played."
msgstr "Namnet på lydfila som skal spelast av."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:14
msgid ""
"Sound file to be played when new messages arrive, if “notify-sound-play-"
"file” is “true”."
msgstr ""
"Lydfil som skal spelast av når nye meldingar kjem, dersom «notify-sound-play-"
"file» er «true»."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:15
msgid "Whether to play a sound file."
msgstr "Om ei lydfil skal spelast av."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:16
msgid ""
"Whether to play a sound file when new messages arrive. The name of the sound "
"file is given by the “notify-sound-file” key."
msgstr ""
"Om ei lydfil skal spelast av når nye meldingar kjem. Namnet på lydfila står "
"i nøkkelen «notify-sound-file»."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:17
msgid "Use sound theme"
msgstr "Bruk lydtema"

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:18
msgid "Play themed sound when new messages arrive, if not in beep mode."
msgstr ""
"Spel av ein temalyd når nye meldingar kjem, om pipemodus ikkje er i bruk."

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:19
msgid "Do not notify for these accounts"
msgstr "Ikkje varsle for desse kontoane"

#: ../data/org.gnome.evolution.plugin.mail-notification.gschema.xml.in.h:20
msgid ""
"Contains UIDs of accounts for which the notifications should be avoided."
msgstr "Inneheld UID-ane til kontoar det ikkje skal varslast for."

#: ../data/org.gnome.evolution.plugin.prefer-plain.gschema.xml.in.h:1
msgid "Mode to use when displaying mails"
msgstr "Modus for vising av e-post"

#: ../data/org.gnome.evolution.plugin.prefer-plain.gschema.xml.in.h:2
msgid ""
"The mode to use for displaying mails. “normal” makes Evolution choose the "
"best part to show, “prefer_plain” makes it use the text part, if present, "
"“prefer_source” makes it use the text part, if present, otherwise shows HTML "
"source, and “only_plain” forces Evolution to only show plain text"
msgstr ""
"Modusen for vising av e-post. «normal» får Evolution til å velje den beste "
"delen å vise, «prefer_plain» får han til å bruke tekstdelen om han finst, "
"«prefer_source» brukar tekstdelen om han finst og viser elles HTML-kjelda, "
"og «only_plain» tvingar Evolution til berre å vise rein tekst"

#: ../data/org.gnome.evolution.plugin.prefer-plain.gschema.xml.in.h:3
msgid "Whether to show suppressed HTML output"
msgstr "Om undertrykt HTML-utdata skal visast"

#: ../data/org.gnome.evolution.plugin.publish-calendar.gschema.xml.in.h:1
msgid "List of Destinations for publishing"
msgstr "Liste over mål for publisering"

#: ../data/org.gnome.evolution.plugin.publish-calendar.gschema.xml.in.h:2
msgid ""
"The key specifies the list of destinations to where publish calendars. Each "
"values specifies an XML with setup for publishing to one destination."
msgstr ""
"Nøkkelen inneheld lista over mål kalendrar skal publiserast til. Kvar verdi "
"er ein XML med oppsettet for publisering til eitt mål."

#: ../data/org.gnome.evolution.plugin.sender-validator.gschema.xml.in.h:1
msgid "[]"
msgstr "[]"

#: ../data/org.gnome.evolution.plugin.sender-validator.gschema.xml.in.h:2
msgid "List of assignments for recipient and the address to be used with it"
msgstr ""
"Liste over tilordningar av mottakarar og adressa som skal brukast for dei"

#: ../data/org.gnome.evolution.plugin.sender-validator.gschema.xml.in.h:3
msgid ""
"The list is of format 'recipient&lt;tab&gt;sender', where the recipient can "
"be part of the address only and the sender is a full email address, which "
"should match the From address precisely."
msgstr ""
"Lista er på forma 'recipient&lt;tab&gt;sender', der mottakaren kan vere "
"berre ein del av adressa, og avsendaren er ei fullstendig e-postadresse som "
"skal passe nøyaktig med Frå-adressa."

#: ../data/org.gnome.evolution.plugin.sender-validator.gschema.xml.in.h:4
msgid "List of assignments for an account, which recipients it accepts"
msgstr "Liste over tilordningar for ein konto, med mottakarane han godtek"

#: ../data/org.gnome.evolution.plugin.templates.gschema.xml.in.h:1
msgid ""
"List of keyword/value pairs for the Templates plugin to substitute in a "
"message body."
msgstr ""
"Liste over nøkkelord/verdi-par som Malar-tillegget skal setje inn i "
"meldingskroppen."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:1
msgid "Skip development warning dialog"
msgstr "Hopp over åtvaringsvindauget for utviklarversjonar"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:2
msgid ""
"Whether the warning dialog in development versions of Evolution is skipped."
msgstr ""
"Om åtvaringsvindauget i utviklarversjonar av Evolution skal hoppast over."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:3
msgid "Initial attachment view"
msgstr "Første vising av vedlegg"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:4
msgid ""
"Initial view for attachment bar widgets. “0” is Icon View, “1” is List View."
msgstr ""
"Første vising for vedleggslinja. «0» er ikonvising, «1» er listevising."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:5
msgid "Initial file chooser folder"
msgstr "Første mappe for filveljaren"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:6
msgid "Initial folder for GtkFileChooser dialogs."
msgstr "Første mappe for GtkFileChooser-vindauge."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:7
msgid "Compression format used by autoar"
msgstr "Komprimeringsformat brukt av autoar"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:8
msgid ""
"Compression format used when compressing attached directories with autoar."
msgstr ""
"Komprimeringsformat som vert brukt når vedlagde mapper vert komprimerte med "
"autoar."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:9
msgid "Compression filter used by autoar"
msgstr "Komprimeringsfilter brukt av autoar"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:10
msgid ""
"Compression filter used when compressing attached directories with autoar."
msgstr ""
"Komprimeringsfilter som vert brukt når vedlagde mapper vert komprimerte med "
"autoar."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:11
#: ../src/shell/e-shell.c:2036
msgid "Start in offline mode"
msgstr "Start i fråkopla modus"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:12
msgid "Whether Evolution will start up in offline mode instead of online mode."
msgstr "Om Evolution skal starte i fråkopla modus i staden for tilkopla modus."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:13
msgid "Offline folder paths"
msgstr "Mappestiar for fråkopla bruk"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:14
msgid ""
"List of paths for the folders to be synchronized to disk for offline usage."
msgstr ""
"Liste over stiar til mappene som skal synkroniserast til disk for fråkopla "
"bruk."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:15
msgid "Enable express mode"
msgstr "Slå på ekspressmodus"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:16
msgid "Flag that enables a much simplified user interface."
msgstr "Flagg som slår på eit mykje forenkla brukargrensesnitt."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:17
msgid "List of button names to hide in the window switcher"
msgstr "Liste over namn på knappar som skal gøymast i vindaugsvekslaren"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:18
msgid ""
"Valid values are “mail”, “addressbook”, “calendar”, “tasks” and “memos”. "
"Change of this requires restart of the application."
msgstr ""
"Gyldige verdiar er «mail», «addressbook», «calendar», «tasks» og «memos». "
"Endring krev omstart av programmet."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:19
msgid "Window buttons are visible"
msgstr "Vindaugsknappane er synlege"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:20
msgid "Whether the window buttons should be visible."
msgstr "Om vindaugsknappane skal vere synlege."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:21
msgid "Window button style"
msgstr "Stil på vindaugsknappane"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:22
msgid ""
"The style of the window buttons. Can be “text”, “icons”, “both”, “toolbar”. "
"If “toolbar” is set, the style of the buttons is determined by the GNOME "
"toolbar setting."
msgstr ""
"Stilen på vindaugsknappane. Kan vere «text», «icons», «both» eller "
"«toolbar». Er «toolbar» sett, vert stilen avgjort av GNOME-innstillinga for "
"verktøylinjer."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:23
msgid "Menubar is visible"
msgstr "Menylinja er synleg"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:24
msgid "Whether the menubar should be visible."
msgstr "Om menylinja skal vere synleg."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:25
msgid "Toolbar is visible"
msgstr "Verktøylinja er synleg"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:26
msgid "Whether the toolbar should be visible."
msgstr "Om verktøylinja skal vere synleg."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:27
msgid "Sidebar is visible"
msgstr "Sidepanelet er synleg"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:28
msgid "Whether the sidebar should be visible."
msgstr "Om sidepanelet skal vere synleg."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:29
msgid "Statusbar is visible"
msgstr "Statuslinja er synleg"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:30
msgid "Whether the status bar should be visible."
msgstr "Om statuslinja skal vere synleg."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:31
msgid "ID or alias of the component to be shown by default at start-up."
msgstr ""
"ID eller alias til komponenten som vert vist som standard ved oppstart."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:32
msgid "Default sidebar width"
msgstr "Standardbreidd på sidepanelet"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:33
msgid "The default width for the sidebar, in pixels."
msgstr "Standardbreidda på sidepanelet, i pikslar."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:34
msgid "Enable special WebKit developer features"
msgstr "Slå på spesielle WebKit-utviklarfunksjonar"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:35
msgid "Any change of this option requires restart of Evolution."
msgstr "Endring av dette valet krev omstart av Evolution."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:36
msgid "The last extension being used when backing up Evolution data."
msgstr "Den sist brukte filendinga ved sikkerheitskopiering av Evolution-data."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:37
msgid ""
"It can be either “.gz” or “.xz” and it influences what extension will be "
"preselected in the file chooser."
msgstr ""
"Ho kan vere «.gz» eller «.xz» og avgjer kva filending som er førehandsvald i "
"filveljaren."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:38
msgid "Prefix of the URI to use to search the web with selected text."
msgstr ""
"Prefiks til URI-en som skal brukast til å søkje på nettet med den valde "
"teksten."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:39
msgid ""
"The prefix of a URL to be used for searches on the web. The actual text "
"selection is escaped and appended to this string. The URI should start with "
"https://."
msgstr ""
"Prefikset til ein URL som skal brukast til søk på nettet. Den valde teksten "
"vert koda og lagd til denne strengen. URI-en skal byrje med https://."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:40
msgid "Minimum font size to be used by WebKitGTK"
msgstr "Minste skriftstorleik for WebKitGTK"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:41
msgid ""
"The minimum font size in pixels used to display text in WebKitGTK. This "
"setting controls the absolute smallest size. Values other than 0 can "
"potentially break page layouts. Negative values are treated as 0."
msgstr ""
"Minste skriftstorleik i pikslar for tekst i WebKitGTK. Denne innstillinga "
"styrer den absolutt minste storleiken. Andre verdiar enn 0 kan øydeleggje "
"sideoppsettet. Negative verdiar vert handsama som 0."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:42
msgid "Set of additional illegal characters in the filename"
msgstr "Sett med fleire ulovlege teikn i filnamn"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:43
msgid ""
"When generating file names from custom strings some non-printable or "
"reserved characters are replaced with an underscore. Here's a set of "
"additional characters to be replaced."
msgstr ""
"Når filnamn vert laga frå eigne strengar, vert nokre teikn som ikkje kan "
"skrivast ut, eller som er reserverte, bytte ut med understrek. Her er eit "
"sett med fleire teikn som skal bytast ut."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:44
msgid "Override toolbar icon size"
msgstr "Overstyr ikonstorleiken i verktøylinja"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:45
msgid ""
"Controls the toolbar icon size. The 'default' value lets the system/code "
"decide what is the best icon size for the toolbar. Changing the option "
"requires application restart."
msgstr ""
"Styrer ikonstorleiken i verktøylinja. Verdien 'default' lèt systemet/koden "
"avgjere den beste ikonstorleiken for verktøylinja. Endring av valet krev "
"omstart av programmet."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:46
msgid "Whether to use header bar in the application"
msgstr "Om topplinja skal brukast i programmet"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:47
msgid ""
"When enabled, adds buttons to the header bar. This applies to dialogs as "
"well. Changing the option requires application restart."
msgstr ""
"Når dette er slått på, vert knappane lagde i topplinja. Dette gjeld òg "
"dialogvindauge. Endring av valet krev omstart av programmet."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:48
msgid "Whether to use icon-only buttons in the header bar"
msgstr "Om knappane i topplinja berre skal ha ikon"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:49
msgid ""
"When enabled, uses icon-only buttons in the header bar. Otherwise some "
"buttons can show also text when there's enough space."
msgstr ""
"Når dette er slått på, har knappane i topplinja berre ikon. Elles kan nokre "
"knappar òg vise tekst når det er plass."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:50
msgid "Whether the markdown editor show have live preview"
msgstr "Om markdown-redigeringa skal ha direkte førehandsvising"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:51
msgid ""
"When enabled, the markdown editor shows a preview beside the editing text "
"and updates it as the user types."
msgstr ""
"Når dette er slått på, viser markdown-redigeringa ei førehandsvising ved "
"sida av teksten og oppdaterer ho medan brukaren skriv."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:52
msgid "Whether to prefer symbolic icons"
msgstr "Om symbolske ikon skal føretrekkjast"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:53
msgid ""
"Controls whether the application should prefer symbolic icons or not. The "
"'auto' value detects whether the icon theme is using symbolic icons. Note "
"the symbolic icons cannot be used when the icon theme does not provide them. "
"Similarly the color icons cannot be used, when they are not available."
msgstr ""
"Styrer om programmet skal føretrekkje symbolske ikon. Verdien 'auto' finn ut "
"om ikontemaet brukar symbolske ikon. Merk at symbolske ikon ikkje kan "
"brukast når ikontemaet ikkje har dei, og fargeikon kan heller ikkje brukast "
"når dei ikkje finst."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:54
msgid "Custom command to convert markdown into HTML"
msgstr "Eigen kommando for å konvertere markdown til HTML"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:55
msgid ""
"When not empty, can contain a command, which will be used to convert "
"markdown into HTML. It can contain also additional arguments, but not shell "
"variables and the like. It's expected that the command reads the markdown "
"from stdin and writes the HTML data into stdout. The command can be called "
"very often, even as the user types, thus make sure it'll not be slow, "
"because it can block the application."
msgstr ""
"Om feltet ikkje er tomt, kan det innehalde ein kommando som vert brukt til å "
"konvertere markdown til HTML. Kommandoen kan òg ha argument, men ikkje "
"skalvariablar og liknande. Kommandoen skal lese markdown frå stdin og skrive "
"HTML-dataa til stdout. Han kan kallast svært ofte, til og med medan brukaren "
"skriv, så sjå til at han ikkje er treg, for han kan blokkere programmet."

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:56
msgid ""
"Additional argument to use with markdown-to-html-command when want to get "
"source position in the output HTML"
msgstr ""
"Ekstra argument til markdown-to-html-command for å få kjeldeplasseringa i "
"HTML-utdataa"

#: ../data/org.gnome.evolution.shell.gschema.xml.in.h:57
msgid ""
"The markdown editor can ask to get also source position as additional `data-"
"sourcepos` attributes, then this argument is added to the markdown-to-html-"
"command command line to include them. It can be empty when not supported by "
"that command."
msgstr ""
"Markdown-redigeringa kan be om kjeldeplasseringa som ekstra `data-sourcepos`-"
"attributt, og då vert dette argumentet lagt til kommandolina for markdown-to-"
"html-command. Det kan vere tomt når kommandoen ikkje støttar det."

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:1
msgid "Use only local spam tests."
msgstr "Bruk berre lokale søppelposttestar."

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:2
msgid "Use only the local spam tests (no DNS)."
msgstr "Bruk berre lokale søppelposttestar (ingen DNS)."

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:3
msgid "Full path command to run spamassassin"
msgstr "Full sti til kommandoen for å køyre spamassassin"

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:4
msgid ""
"Full path to a spamassassin command. If not set, then a compile-time path is "
"used, usually /usr/bin/spamassassin. The command should not contain any "
"other arguments."
msgstr ""
"Full sti til ein spamassassin-kommando. Om han ikkje er sett, vert ein sti "
"frå kompileringa brukt, vanlegvis /usr/bin/spamassassin. Kommandoen skal "
"ikkje innehalde andre argument."

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:5
msgid "Full path command to run sa-learn"
msgstr "Full sti til kommandoen for å køyre sa-learn"

#: ../data/org.gnome.evolution.spamassassin.gschema.xml.in.h:6
msgid ""
"Full path to a sa-learn command. If not set, then a compile-time path is "
"used, usually /usr/bin/sa-learn. The command should not contain any other "
"arguments."
msgstr ""
"Full sti til ein sa-learn-kommando. Om han ikkje er sett, vert ein sti frå "
"kompileringa brukt, vanlegvis /usr/bin/sa-learn. Kommandoen skal ikkje "
"innehalde andre argument."

#: ../data/org.gnome.evolution.text-highlight.gschema.xml.in.h:1
msgid "Whether the text-highlight module is enabled"
msgstr "Om modulen for tekstutheving er slått på"

#: ../data/org.gnome.evolution.text-highlight.gschema.xml.in.h:2
msgid "Theme name to use, defaults to “bclear”"
msgstr "Namn på tema som skal brukast, standard er «bclear»"

#: ../data/org.gnome.evolution.text-highlight.gschema.xml.in.h:3
msgid ""
"Use “highlight --list-scripts=themes” to get the list of installed themes "
"and then the value to one of them. The change requires only re-format of the "
"message part to take into effect, like using right-click→Format As→...."
msgstr ""
"Bruk «highlight --list-scripts=themes» for å få lista over installerte tema, "
"og set verdien til eitt av dei. Endringa får verknad når meldingsdelen vert "
"formatert på nytt, til dømes med høgreklikk→Formater som→...."

